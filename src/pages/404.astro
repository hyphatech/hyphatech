---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Closing from "../components/Closing.astro";
import Icon from "../components/Icon.astro";
import House from "@lucide/astro/icons/house";

/* The host serves this for any address it cannot find. It opens as
   every page does, on the hero's Ember, and ends as every page does. */
---

<Base
  title="Nothing at this address · Hypha"
  description="There is no page at this address."
  lost
>
  <Hero slot="band" title={["Nothing at", "this address."]}>
    The page may have moved.
    <Fragment slot="actions">
      <a href="/" class="btn-primary"><Icon icon={House} />Home</a>
    </Fragment>
  </Hero>

  <Closing />
</Base>
