---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Opener from "../components/Opener.astro";
import Closing from "../components/Closing.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import Globe from "@lucide/astro/icons/globe";
import Braces from "@lucide/astro/icons/braces";
import Database from "@lucide/astro/icons/database";
import Activity from "@lucide/astro/icons/activity";
import KeyRound from "@lucide/astro/icons/key-round";
import ListTodo from "@lucide/astro/icons/list-todo";
import AppWindow from "@lucide/astro/icons/app-window";
import ChartColumn from "@lucide/astro/icons/chart-column";
import Webhook from "@lucide/astro/icons/webhook";
import ArrowDown from "@lucide/astro/icons/arrow-down";
import CodeXml from "@lucide/astro/icons/code-xml";
import Shapes from "@lucide/astro/icons/shapes";
import Lock from "@lucide/astro/icons/lock";
import ScanText from "@lucide/astro/icons/scan-text";
import FileCode from "@lucide/astro/icons/file-code";

/* Hypha Stack, the open half of Hypha: what anyone can read and build
   on. The ontology and the practices are the factory's, and on its
   page.

   top           what it is in two lines, its name in the lede, the
                 ways in
   components    capabilities, each with the libraries that provide it
   ocaml         OCaml, the outermost boundary, not the thing sold
   build         the ways in

   Claim only what the repositories bear out; where a thing holds only
   once turned on, say so. No promises, dates, roadmap or private links. */

const page = (slug: string) => `/stack/${slug}/`;

/* The map's capabilities that open code provides; a library may serve
   several, and each has its own page. The map links its concepts to
   these by id. */
const spindle = { name: "Spindle", href: page("spindle") };
const capabilities = [
  {
    id: "http",
    icon: Globe,
    name: "HTTP and APIs",
    is: "An RFC-strict web framework, typed end to end, fast and multi-core by design. OpenAPI docs via Scalar.",
    by: [spindle],
  },
  {
    id: "contracts",
    icon: Braces,
    name: "Data contracts",
    is: "Unified JSON contracts, strict by the standard, for backend, frontend and agents. Printed as JSON Schema and Zod.",
    by: [{ name: "Wiretype", href: page("wiretype") }, spindle],
  },
  {
    id: "data",
    icon: Database,
    name: "Data and persistence",
    is: "Typed Postgres queries, checked against the database schema. Migrations built in, on a native driver with TLS, pooling and failover.",
    by: [{ name: "Rowtype", href: page("rowtype") }, spindle, { name: "Postgres driver", href: page("postgres-eio") }],
  },
  {
    id: "observe",
    icon: Activity,
    name: "Observability",
    is: "OpenTelemetry-compatible logs, traces and metrics, from the first request into every query. Health checks for any orchestrator, and no secret ever logged.",
    by: [spindle],
  },
  {
    id: "identity",
    icon: KeyRound,
    name: "Identity and access",
    is: "Sessions, CSRF and CORS, secure by default. Standard credentials and per-route rate limits.",
    by: [spindle],
  },
  {
    id: "messaging",
    icon: ListTodo,
    name: "Jobs",
    is: "A durable job queue in your own Postgres that scales. Scheduled, prioritised and resilient.",
    by: [{ name: "Spool", href: page("spool") }],
  },
  {
    id: "ui",
    icon: AppWindow,
    name: "Front end",
    is: "Reactive front ends on SolidJS, with accessible components. Same language and shared types, from the browser to the database.",
    by: [{ name: "Solidtype", href: page("solidtype") }],
  },
];

/* Work in progress, filling the grid's last row. */
const coming = [
  { name: "Analytics", icon: ChartColumn, is: "Typed dataframes and an embedded OLAP engine." },
  { name: "Integrations", icon: Webhook, is: "Webhooks, notifications and SDKs for third-party services." },
];


/* OCaml's properties, each as what the stack uses it for. */
const ocaml = [
  {
    icon: Shapes,
    title: "Types that model the domain",
    body: "Variants and records name each state, pattern matching handles each one, and the compiler warns of a case left out.",
  },
  {
    icon: Lock,
    title: "Boundaries in the language",
    body: "Module signatures and abstract types say what a component exposes, and the compiler holds every caller to it.",
  },
  {
    icon: ScanText,
    title: "Code that reads as its model",
    body: "Concise, with types inferred, keeping intent and failure cases in plain sight.",
  },
];

/* OCaml's users, labelled as OCaml's, never Hypha's. */
const users = ["Jane Street", "Bloomberg", "Meta", "Docker", "Ahrefs", "Tezos", "LexiFi", "Citrix"];

---

<Base
  title="Hypha Stack · Hypha"
  description="Hypha Stack: open components made to fit together, in a language that makes their contracts binding."
>
  {/* The hero every product page has. */}
  <Hero slot="band" rail="Components" title={["Components made", "to fit together."]}>
    Designed from the ground up to build software that lasts.
    <Fragment slot="actions">
      <a href="#components" class="btn-primary"><Icon icon={ArrowDown} />See the components</a>
      <a href="https://github.com/hyphatech" class="btn"><Icon icon={CodeXml} />GitHub</a>
    </Fragment>
  </Hero>

  {/* A cell per capability in one ruled grid, its icon bare; library
      names come second, as links, since they mean nothing unopened. The
      last row's cells, tagged WIP, name no date. */}
  <Section id="components" rail="Everything a product needs" class="theme-light">
    <Opener title="Everything a product needs, built once.">
      Each capability is made one way, tested together, and shared by
      every product built on the Stack.
    </Opener>
    <ul class="mt-12 grid gap-px overflow-hidden rounded-panel border border-rule bg-rule md:grid-cols-2 lg:grid-cols-3">
      {
        capabilities.map((c) => (
          <li id={`cap-${c.id}`} data-part={c.id} class="flex scroll-mt-24 flex-col bg-ivory p-7">
            <Icon icon={c.icon} size="lg" />
            <h3 class="t-h3 mt-5">{c.name}</h3>
            <p class="mt-2 grow text-graphite">{c.is}</p>
            <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
              {c.by.map((b) => (
                <a href={b.href} class="link group inline-flex items-center gap-1 pointer-coarse:min-h-11">
                  {b.name}
                  <Arrow way="on" class="size-4" />
                </a>
              ))}
            </p>
          </li>
        ))
      }
      {
        coming.map((c) => (
          <li class="flex flex-col bg-ivory p-7">
            <Icon class="text-graphite" icon={c.icon} size="lg" />
            <h3 class="t-h3 mt-5 text-graphite">{c.name}</h3>
            <p class="mt-2 grow text-graphite">{c.is}</p>
            <p class="mt-6"><span class="k-tag ml-0">WIP</span></p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* The need, then what the language states as three points beside
      the compiler catching a case left out, and OCaml's users, labelled
      as OCaml's. The code is an example, not taken from a product. */}
  <Section id="ocaml" rail="What the language cannot say" class="k-lit">
    <Opener title={["What the language cannot say,", "the system cannot get wrong."]}>
      <a href="https://ocaml.org" class="link-inline group text-ink">OCaml<Arrow way="out" class="ml-1 inline size-[0.8em] align-[-0.05em]" /></a> meets every need at once, and
      the stack is built within its limits. It makes contracts and
      failure cases explicit, but it does not make an application correct on
      its own.
    </Opener>
    <div class="mt-12 grid grid-cols-1 items-center gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <ul class="space-y-6">
        {
          ocaml.map((o) => (
            <li class="k-point">
              <span class="k-point-icon"><Icon icon={o.icon} /></span>
              <div><p class="font-medium">{o.title}</p><p class="mt-1 text-graphite">{o.body}</p></div>
            </li>
          ))
        }
      </ul>
      {/* Each state a type, and the signature the only way between
          them: refunding a draft cannot be written. The error's first
          two lines as OCaml 5.5 prints them. */}
      <div class="k-panel">
        <p class="k-panel-head"><span class="k-panel-name inline-flex items-center gap-2 font-mono"><Icon icon={FileCode} />invoice.ml</span><span class="font-mono">dune build</span></p>
        <pre tabindex="0" class="k-panel-well overflow-x-auto px-5 py-4 font-mono text-sm leading-6"><code><span class="text-accent">type</span> draft <span class="text-accent">and</span> sent <span class="text-accent">and</span> paid

<span class="text-accent">module</span> Invoice <span class="text-graphite">:</span> <span class="text-accent">sig</span>
  <span class="text-accent">type</span> 'state t
  <span class="text-accent">val</span> send   <span class="text-graphite">:</span> draft t <span class="text-graphite">-&gt;</span> sent t
  <span class="text-accent">val</span> pay    <span class="text-graphite">:</span> sent t <span class="text-graphite">-&gt;</span> paid t
  <span class="text-accent">val</span> refund <span class="text-graphite">:</span> paid t <span class="text-graphite">-&gt;</span> sent t
<span class="text-accent">end</span>

<span class="text-accent">let</span> oops <span class="text-graphite">=</span> Invoice.refund draft</code></pre>
        {/* On a phone the error wraps without the compiler's indent,
            rather than shrinking to fit its lines. */}
        <pre class="k-panel-foot font-mono whitespace-pre-wrap max-sm:text-xs">Error: The value draft has type draft Invoice.t
<span class="max-sm:hidden">       </span>but an expression was expected of type <span class="text-accent">paid Invoice.t</span></pre>
      </div>
    </div>
    {/* Stops under keyboard focus; a tap, click, Enter or Space holds
        it until the next. */}
    <div
      class="mt-12 grid items-center gap-4 md:gap-6 md:grid-cols-margin"
      role="group"
      aria-labelledby="ocaml-users-label"
      data-strip
    >
      <p id="ocaml-users-label" class="t-label text-graphite">OCaml in production at</p>
      {/* The hold, as a toggle a screen reader names and reads the state
          of; the names stay a list beside it. The row draws its focus.
          Shown by the script, which is what holds it. */}
      <button type="button" class="sr-only" aria-pressed="false" aria-controls="ocaml-users" hidden data-hold>Hold still</button>
      <div class="marquee" id="ocaml-users" data-marquee>
        <div class="marquee-track">
          {
            [false, true].map((copy) => (
              <ul class="flex shrink-0" aria-hidden={copy ? "true" : undefined}>
                {users.map((u) => (
                  <li class="t-h2 px-6 whitespace-nowrap text-graphite md:px-8">{u}</li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  <Closing />
</Base>

<script>
  import { onVisible, reducedMotion } from "../lib/motion";

  /* Rests off screen; a tap or click on the row, or the hold button,
     toggles a hold. With reduced motion it is already still, so the
     button stays hidden. */
  const still = reducedMotion.matches;
  for (const strip of document.querySelectorAll<HTMLElement>("[data-marquee]")) {
    onVisible(strip, (visible) => strip.toggleAttribute("data-paused", !visible));
    const row = strip.closest<HTMLElement>("[data-strip]");
    const button = row?.querySelector<HTMLButtonElement>("[data-hold]");
    if (!row || !button || still) continue;
    button.hidden = false;
    /* The button's own click, from Enter or Space too, bubbles here. */
    row.addEventListener("click", () => {
      const held = strip.toggleAttribute("data-held");
      button.setAttribute("aria-pressed", String(held));
    });
  }
</script>
