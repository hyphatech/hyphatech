---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import ArrowDown from "@lucide/astro/icons/arrow-down";
import Clock from "@lucide/astro/icons/clock";
import Laptop from "@lucide/astro/icons/laptop";
import Scale from "@lucide/astro/icons/scale";
import Section from "../components/Section.astro";
import Opener from "../components/Opener.astro";
import Closing from "../components/Closing.astro";
import Demo from "../components/Demo.astro";
import Steps from "../components/Steps.astro";
import Graph from "../components/Graph.astro";
import Compare from "../components/Compare.astro";
import DecisionCards from "../components/DecisionCards.astro";
import RunChart from "../components/RunChart.astro";
import Vaults from "../components/Vaults.astro";
import Autonomy from "../components/Autonomy.astro";
import Presets from "../components/Presets.astro";
import Points from "../components/Points.astro";
import { hafWays } from "../content/ways";
import { held, record, screen, solved, steps, vaults } from "../content/factory";

/* Hypha Autonomous Factory, the Factory: all this page is about.

   For engineers who want to try it, written with everyone in mind: why
   each part matters, its mechanism only as a short proof, every claim
   one hypha-haf's documentation states. It sells the blend -- the
   screen, the tools, the Ontology, the harness, autonomy that is safe
   -- in the order a piece of work meets it. Every figure is a region of
   HAF's own screens (Crop), through the task tracker's run the demo
   plays, never drawn by hand:

   It tells one story, each section answering one question and none
   telling what another does: the promise, shown, what it solves, how it works, why it
   gets it right, why it is safe, so you can let go, how it is
   engineered, on your terms, what it is worth, and the call.

   top       the promise: the factory for durable software, nothing to
             babysit, and that it is coming soon, with no date
   showcase  shown: the demo, in the hero's band under its buttons, the
             hero's ground following its chapter: Ember, Overhead, lit
             night, Ember mirrored, Horizon
   solved    what it solves: each problem taken off your hands, a cell
             each linking to the section that proves it, as the kit's points,
             as /modernise sets what it covers, on paper
   steps     how it works: six steps as a magazine, each the step live
             on HAF's screen across the page, its words under it, on
             Ember, its light following the step in view
   vault     why it gets it right, 1: Hypha Vault and the Project Vault,
             the boundaries both set, on Horizon
   ontology  why it gets it right, 2: what software is made of, under
             the Ontology's map, on night over fine dots
   harness   why it is safe: a model proposes, the Factory decides, an
             instructed agent beside the Factory, on Ember mirrored
   screen    so you can let go: hands off until the release, your lane
             and the Factory's over time, the scroll its clock, on night
             over fine dots, its steps raised tiles
   inside    how it is engineered: the decisions it rests on, a drawing
             each, on Ember, its grounds blending as the decisions pass
   models    on your terms, and what sets the cost: any model, a preset
             beside the providers, on lit night
   economy   what it is worth: fewer tokens and less spent at a higher
             bar, two figures beside the opener, on paper
   record    every number accounted for: the demo's own run charted from
             its journal, on Ember
   build     the ways in

   No eyebrow over a heading, no legend under a figure, no prices, no
   prerequisite. */



/* What the Factory saves: the same signed PRD built by one agent with
   instructions and by the Factory. */
const economy = [
  { number: "58%", what: "fewer tokens per delivered change", limit: "The same signed PRD, built by one agent with instructions and by the Factory.", by: "Hypha's benchmark, 2026" },
  { number: "3.1×", what: "cheaper per delivered change", limit: "Every signed scenario proven in the Factory's run, against the agent's own claim of done.", by: "Hypha's benchmark, 2026" },
];



/* What the Factory will be, bare labels beside the hero's button, as
   its coming soon is, from a tablet up, where they keep its one row. */
const facts = [
  { icon: Laptop, label: "macOS, Linux" },
  { icon: Scale, label: "Apache-2.0" },
];

/* Three points under a section's words and figure, in a row. */
const row = "grid gap-x-10 gap-y-6 md:grid-cols-3 [&>*]:!my-0";
---

<Base
  title="Hypha Autonomous Factory · Hypha"
  description="Hypha Autonomous Factory, the autonomous factory for durable software. You make the decisions, and it does the rest, turning them into a tested release, ready to ship."
>
  <Hero slot="band" rail="The autonomous factory" title={["The autonomous factory", "for durable software."]}>
    You make the decisions. Hypha Autonomous Factory does the rest, turning them into a tested release, ready to ship.
    <Fragment slot="actions">
      <a href="#showcase" class="btn-primary"><Icon icon={ArrowDown} />See it at work</a>
      <span class="t-control inline-flex items-center gap-2 self-center px-1 text-graphite"><Icon icon={Clock} />Coming soon</span>
      {
        facts.map((f) => (
          <span class="t-control inline-flex items-center gap-2 self-center px-1 text-graphite max-md:hidden">
            <Icon icon={f.icon} />
            {f.label}
          </span>
        ))
      }
    </Fragment>
    <div slot="ground" class="grounds" aria-hidden="true">
      <div data-ground="overhead"></div>
      <div data-ground="lit"></div>
      <div data-ground="mirrored"></div>
      <div data-ground="horizon"></div>
    </div>
    <div slot="after" id="showcase" class="scroll-mt-8">
      <Demo label="A session of Hypha Autonomous Factory, from a request to a released change." />
    </div>
  </Hero>

  {/* What it solves, answered at once: each problem the Factory takes
      off your hands, a cell of the ruled grid /modernise starts with,
      linking down to the section that proves it, in the page's order.
      On paper, between the hero's light and the steps' night. */}
  <Section id="solved" rail="The hard parts, handled" class="theme-light">
    <Opener title="The hard parts, handled.">
      Agents write fast, and someone still has to watch them, guess with
      them and pay for their guesses. The Factory takes all of it off your
      hands.
    </Opener>
    <ul class="mt-12 grid gap-x-12 gap-y-8 md:grid-cols-2 md:gap-y-12 lg:grid-cols-3">
      {
        solved.map((c) => (
          <li class="k-point border-t border-rule pt-5 md:pt-6">
            <span class="k-point-icon"><Icon icon={c.icon} /></span>
            <div>
              <h3 class="t-h3">{c.title}</h3>
              <p class="mt-2 text-graphite">{c.body}</p>
              {c.link && <a href={c.link.href} class="link mt-3 inline-block">{c.link.text}</a>}
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* The six steps on Ember, its light following the step in view as
      the hero's follows the demo, read in order as a magazine: each step
      live on HAF's screen across the page, its words under it. */}
  <Section id="steps" rail="Six steps" class="theme-ember isolate overflow-hidden" grain>
    <div slot="ground" class="grounds step-grounds" data-chapter="overhead" aria-hidden="true">
      <div data-ground="overhead"></div>
      <div data-ground="lit"></div>
      <div data-ground="mirrored"></div>
      <div data-ground="horizon"></div>
    </div>
    <Opener title="Six steps.">
      It begins by settling your requirements, question by question, until
      nothing is left to guess. Once you agree, the Factory runs the rest.
    </Opener>
    <Steps steps={steps} />
  </Section>

  {/* One source of truth, the Factory's two hearts: Hypha's vault and
      the project's own, each feeding every model at every step, drawn
      under its opener, then three points under it, on Horizon after
      the steps' Ember, handing over to the Ontology. The
      plate with its gold corners is kept for Hypha's selling points. */}
  <Section id="vault" rail="Two vaults" class="k-horizon overflow-x-clip" grain>
    <Opener title={["Two vaults.", "One system."]} mark>
      Hypha Vault is the pluggable source of truth for how software is
      built. Your Project Vault holds what to build and where each part
      belongs. Together they set the boundaries every change is held to.
    </Opener>
    <div class="mt-12">
      <Vaults />
    </div>
    <Points points={vaults} class={`mt-16 ${row}`} />
  </Section>

  {/* The Ontology on its own: what it knows, under its map. No legend:
      a hovered concept says what it is and what provides it. On lit
      night and fine dots, as the landing's boundaries. */}
  <Section id="ontology" rail="The Ontology" class="overflow-x-clip">
    <Opener id="ontology-title" title="The Ontology.">
      The Ontology names every part an application is made of, what each
      one means and how it relates to the rest, and which component of
      Hypha Stack already provides it.
    </Opener>
    {/* On fine dots edge to edge, fading out above and below, as the
        landing's jig lies. */}
    <div class="relative isolate mt-12">
      <div class="dotted pointer-events-none absolute inset-y-0 left-1/2 -z-10 w-screen -translate-x-1/2 [mask-image:linear-gradient(transparent,#000_15%,#000_85%,transparent)]" aria-hidden="true"></div>
      <Graph labelledby="ontology-title" />
    </div>
  </Section>

  {/* The harness: held, never told. What an agent is told in a prompt
      beside what the Factory holds by a wall, as the landing compares
      the disposable and the durable: two panels of the same rows, the
      Factory's in gold. Every row is what hypha-haf's tools, gates and
      build pages say the harness does. On Ember mirrored, so it never
      repeats the hero's light. */}
  <Section id="harness" rail="A model proposes" class="theme-ember k-mirrored overflow-hidden" grain>
    <Opener title={["A model proposes.", "The Factory decides."]} mark>
      An instruction can be ignored. A wall cannot. Every boundary around
      your model is held by the Factory, never left to a sentence it may
      skip.
    </Opener>
    <Compare class="mt-12" {...held} />
  </Section>

  {/* Autonomy: a piece of work from your side and the Factory's, drawn
      as two lanes over time, its steps raised tiles, then three points
      under it. On night over fine dots. */}
  <Section id="screen" rail="Hands off until the release" class="overflow-x-clip">
    <Opener title="Hands off until the release.">
      Once signed, the work runs by itself, keeping you aware of anything
      unforeseen.
    </Opener>
    <div class="relative isolate mt-6 py-6">
      <div class="dotted pointer-events-none absolute inset-y-0 left-1/2 -z-10 w-screen -translate-x-1/2 [mask-image:linear-gradient(transparent,#000_15%,#000_85%,transparent)]" aria-hidden="true"></div>
      <Autonomy />
    </div>
    <Points points={screen} class={`mt-2 lg:mt-12 ${row}`} />
  </Section>

  {/* Inside: the decisions the Factory rests on, a drawing each, on
      Ember, its grounds blending one into the next as the decisions
      pass, as the hero's follow the demo. */}
  <Section id="inside" rail="Under the hood" class="theme-ember isolate overflow-hidden" grain>
    <div slot="ground" class="grounds hood-grounds" data-chapter="overhead" aria-hidden="true">
      <div data-ground="overhead"></div>
      <div data-ground="lit"></div>
      <div data-ground="mirrored"></div>
      <div data-ground="horizon"></div>
    </div>
    <Opener title="Under the hood.">
      Models write the code. The difference is in the design decisions around them.
    </Opener>
    <div class="mt-12"><DecisionCards /></div>
  </Section>

  {/* The models: a preset names one for each kind of work, one drawn
      mixing providers, the providers today and coming under it, on lit
      night, its light under the presets. */}
  <Section id="models" rail="Any model" class="k-lit">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
      <div>
        <Opener title={["Any model.", "The right one for each job."]} mark>
          The strongest model where judgement matters, a faster or cheaper one where it does not. Any model, from any provider, in presets of your own to switch between.
        </Opener>
      </div>
      <Presets />
    </div>
  </Section>

  {/* What it is worth: the promise in numbers, as the landing sets its
      figures, the opener beside two of them on paper. */}
  <Section id="economy" rail="Less spent" class="theme-light">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center">
      <div>
        <Opener title={["Less spent.", "A higher bar."]}>
          With HAF you get more for less. A program does everything it can,
          the right model does the rest, and work already proven
          is never paid for twice. Faster, cheaper, and built to last.
        </Opener>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          economy.map((r) => (
            <li class="flex">
              <div class="k-figure flex w-full flex-col">
                <p class="k-figure-number" data-rise>{r.number}</p>
                <p class="mt-4">{r.what}</p>
                <p class="mt-3 text-sm text-graphite">{r.limit}</p>
                <p class="mt-auto pt-4 text-sm text-graphite">{r.by}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  {/* On the record, on Ember, the page's payoff: the demo's own run
      charted from its journal, under its opener, then three points under
      it. */}
  <Section id="record" rail="Every run on the record" class="theme-ember overflow-hidden" grain>
      <Opener title="Every run on the record.">
        A complete audit trail that nobody can quietly rewrite. Every
        attempt, verdict and refusal is kept
        with its reason, and run after run it adds up to a clear view of
        cost, speed and quality.
      </Opener>
      <div class="mt-12"><RunChart /></div>
      <Points points={record} class={`mt-16 ${row} [&>li]:border-t [&>li]:border-rule [&>li]:pt-6`} />
  </Section>


  <Closing paths={hafWays} />
</Base>



<script>
  import { onScroll, reducedMotion } from "../lib/motion";
  import { powerCompare } from "../lib/power";
  import { riseNumbers } from "../lib/rise";
  riseNumbers();
  const harness = document.querySelector<HTMLElement>("#harness .k-compare");
  if (harness) powerCompare(harness);

  /* The hero's ground follows the demo's chapter, one of the legal
     grounds each, cross-fading between them. */
  const grounds = document.querySelector<HTMLElement>(".grounds");
  if (grounds) {
    const of: Record<string, string> = { Decisions: "overhead", PRD: "lit", Build: "mirrored", Release: "horizon" };
    const set = (chapter: string) => (grounds.dataset.chapter = of[chapter] ?? "ember");
    set(document.querySelector(".demo .tab[aria-current]")?.getAttribute("aria-label") ?? "");
    document.querySelector("#top .demo")?.addEventListener("haf:frame", (e) => set((e as CustomEvent<{ chapter: string }>).detail.chapter));
  }

  const hood = document.querySelector<HTMLElement>(".hood-grounds");
  const marks = [...document.querySelectorAll<HTMLElement>("#inside .decision > .mark")];
  if (hood && marks.length && !reducedMotion.matches) {
    const light = ["overhead", "lit", "ember", "mirrored", "horizon"];
    let at = -1;
    const draw = () => {
      const y = innerHeight * 0.6;
      let on = 0;
      marks.forEach((m, i) => {
        if (m.getBoundingClientRect().top <= y) on = i;
      });
      if (on === at) return;
      at = on;
      hood.dataset.chapter = light[on % light.length]!;
    };
    onScroll(draw);
  }
</script>

