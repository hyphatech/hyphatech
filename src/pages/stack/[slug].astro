---
import { Code } from "astro:components";
import Base from "../../layouts/Base.astro";
import TitleBand from "../../components/TitleBand.astro";
import Section from "../../components/Section.astro";
import Closing from "../../components/Closing.astro";
import Icon from "../../components/Icon.astro";
import Arrow from "../../components/Arrow.astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { byEntry, components, install, releaseUrl, repoUrl, type Component } from "../../content/components";
import { groups, relations, things, type Thing } from "../../content/ontology";
import { codeTheme } from "../../lib/code-theme";
import Bench from "../../components/Bench.astro";

/* One page per open component, the same for each, in the order a
   reader asks: what it is, how to get it, what code with it looks like,
   and where it sits in the ontology. The words and snippets are its
   README's. */

export function getStaticPaths() {
  return components.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Component };
const repo = repoUrl(c);

/* Its corner of the ontology: the concepts it provides, and every
   relation that touches one. */
const provided = things.filter((t) => t.entry !== undefined && c.entries.includes(t.entry));
const ids = new Set(provided.map((t) => t.id));
const thing = (id: string) => things.find((t) => t.id === id);
const touching = relations.flatMap((r) => {
  const from = thing(r.from);
  const to = thing(r.to);
  return from && to && (ids.has(r.from) || ids.has(r.to)) ? [{ from, to, label: r.label }] : [];
});
const capabilities = groups.filter((g) => provided.some((t) => t.group === g.id));

/* A concept another component provides links to that component's page. */
const elsewhere = (t: Thing) => (t.entry && !ids.has(t.id) ? byEntry(t.entry) : undefined);

/* Splits [text](url) links out of a paragraph. */
const runs = (p: string) =>
  p.split(/(\[[^\]]+\]\([^)]+\))/).map((s) => {
    const m = s.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
    return m ? { text: m[1]!, href: m[2]! } : s;
  });

const row = "grid gap-y-6 md:grid-cols-margin";
const code = "rounded-panel border border-rule p-5 text-sm leading-relaxed overflow-x-auto";
---

<Base title={`${c.name} · Hypha Stack`} description={`${c.name}: ${c.tagline}`}>
  <TitleBand title={c.name}>
    <a slot="above" href="/stack#components" class="link group inline-flex gap-1.5">
      <Arrow way="back" />
      Hypha Stack
    </a>
    <p class="t-lede mt-6 max-w-2xl text-graphite">{c.tagline}</p>
    <p class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a href={repo} class="btn-primary group">
        Source on GitHub
        <Arrow way="out" />
      </a>
      {
        c.docs && (
          <a href={c.docs} class="btn group">
            Documentation
            <Arrow way="out" />
          </a>
        )
      }
      <a href={releaseUrl(c)} class="link group inline-flex gap-1">
        Latest: {c.version}
        <Arrow way="out" />
      </a>
    </p>
  </TitleBand>

  {/* What it is, then how to get it: the margin names each part. */}
  <Section class="theme-light">
    <div class={row}>
      <h2 class="t-label pt-1.5 text-graphite">About</h2>
      <div class="max-w-2xl space-y-4 leading-relaxed">
        {
          c.about.map((p) => (
            <p>
              {runs(p).map((r) =>
                typeof r === "string" ? (
                  r
                ) : (
                  <a href={r.href} target="_blank" rel="noopener" class="link-inline group">
                    {r.text}
                    <Arrow way="out" class="ml-0.5 inline size-[0.8em] align-[-0.05em]" />
                  </a>
                ),
              )}
            </p>
          ))
        }
        {
          capabilities.length > 0 && (
            <p class="flex flex-wrap gap-2 pt-2">
              {capabilities.map((g) => (
                <a href={`/stack#cap-${g.id}`} class="t-control rounded-full border border-rule px-3 py-1 text-graphite transition-colors hover:border-graphite hover:text-ink">
                  {g.name}
                </a>
              ))}
            </p>
          )
        }
      </div>
    </div>
    <div class:list={[row, "mt-14"]}>
      <h2 class="t-label pt-1.5 text-graphite">Install</h2>
      <div class="min-w-0 max-w-3xl space-y-4">
        <p class="leading-relaxed text-graphite">From Hypha's opam repository, on OCaml 5.5 or later:</p>
        <Code code={install(c)} lang="shellscript" theme={codeTheme} class={code} />
        <p class="leading-relaxed text-graphite">Then in your <code class="font-mono text-sm text-ink">dune</code> file:</p>
        <Code code={c.dune} lang="lisp" theme={codeTheme} class={code} />
      </div>
    </div>
  </Section>

  <Section>
      <div class={row}>
        <h2 class="t-label pt-1.5 text-graphite">In code</h2>
        <ol class="min-w-0 max-w-3xl space-y-10">
          {
            c.snippets.map((s) => (
              <li class="space-y-4">
                <p class="leading-relaxed text-graphite">{s.caption}</p>
                <Code code={s.code} lang={s.lang as never} theme={codeTheme} class={code} />
              </li>
            ))
          }
        </ol>
      </div>
  </Section>

  {
    c.bench && (
      <Section>
          <div class={row}>
            <h2 class="t-label pt-1.5 text-graphite">Under load</h2>
            <Bench bench={c.bench} name={c.name} />
          </div>
      </Section>
    )
  }

  {/* The relations that touch its concepts: its own in ink, another
      component's linked to its page, and the ones no open code provides
      dashed. The ontology is not open; this only illustrates it. */}
  <Section>
      <div class={row}>
        <h2 class="t-label pt-1.5 text-graphite">Ontology</h2>
        <div class="min-w-0 max-w-4xl">
          <ul class="grid gap-x-10 gap-y-3 lg:grid-cols-2">
            {
              touching.map((r) => (
                <li class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5">
                  {[r.from, r.to].map((t, i) => {
                    const other = elsewhere(t);
                    const chip = [
                      "t-control rounded-full border px-3 py-1",
                      ids.has(t.id) ? "border-ink text-ink" : t.entry ? "border-rule text-graphite" : "border-dashed border-rule text-graphite",
                      i === 1 && "order-3",
                    ];
                    return other ? (
                      <a href={`/stack/${other.slug}`} class:list={[chip, "transition-colors hover:border-graphite hover:text-ink"]} title={`${t.name}, from ${other.name}`}>
                        {t.name}
                      </a>
                    ) : (
                      <span class:list={chip}>{t.name}</span>
                    );
                  })}
                  <span class="order-2 inline-flex items-center gap-1.5 text-sm text-graphite">
                    {r.label}
                    <Icon icon={ArrowRight} />
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
  </Section>

  <Closing />
</Base>
