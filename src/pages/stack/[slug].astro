---
import { Code } from "astro:components";
import Base from "../../layouts/Base.astro";
import TitleBand from "../../components/TitleBand.astro";
import Section from "../../components/Section.astro";
import Closing from "../../components/Closing.astro";
import Arrow from "../../components/Arrow.astro";
import { components, install, opamUrl, repoUrl, type Component } from "../../content/components";
import Icon from "../../components/Icon.astro";
import CodeXml from "@lucide/astro/icons/code-xml";
import BookOpen from "@lucide/astro/icons/book-open";
import Tag from "@lucide/astro/icons/tag";
import Layers from "@lucide/astro/icons/layers";
import { groups, things } from "../../content/ontology";
import { codeTheme } from "../../lib/code-theme";
import { organization } from "../../lib/schema";

/* One page per open component, the same for each, in the order a
   reader asks: what it is, how to get it, and what code with it looks
   like. The words and snippets are its README's. */

export function getStaticPaths() {
  return components.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Component };
const repo = repoUrl(c);

const schema = {
  "@type": "SoftwareSourceCode",
  name: c.name,
  description: c.tagline,
  url: `https://hyphatech.io/stack/${c.slug}/`,
  codeRepository: repo,
  programmingLanguage: "OCaml",
  license: "https://opensource.org/license/mit",
  version: c.version,
  author: { "@id": organization["@id"] },
};

/* The capabilities its concepts belong to, linked to the map. */
const provided = things.filter((t) => t.entry !== undefined && c.entries.includes(t.entry));
const capabilities = groups.filter((g) => provided.some((t) => t.group === g.id));

/* Splits [text](url) links out of a paragraph. */
const runs = (p: string) =>
  p.split(/(\[[^\]]+\]\([^)]+\))/).map((s) => {
    const m = s.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
    return m ? { text: m[1]!, href: m[2]! } : s;
  });

const row = "grid gap-y-6 md:grid-cols-margin";
const code = "rounded-panel border border-rule p-5 text-sm leading-relaxed overflow-x-auto";
---

<Base title={`${c.name} · Hypha Stack`} description={`${c.name}: ${c.tagline}`} schema={schema}>
  <TitleBand slot="band" rail={c.name} title={c.name}>
    {/* Where it stands: the Stack, then this component, on one
        baseline, so the underlined link sits level with the name. On a
        phone the latest version shares the line, so it never wraps
        alone under the buttons. */}
    <div slot="above" class="t-control flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2.5">
          <li class="flex"><a href="/stack/#components" class="link inline-flex items-center gap-2"><Icon icon={Layers} />Hypha Stack</a></li>
          <li class="text-graphite/60" aria-hidden="true">/</li>
          <li class="flex"><span aria-current="page" class="text-ink">{c.name}</span></li>
        </ol>
      </nav>
      <a href={opamUrl(c)} class="link group inline-flex items-center gap-1.5 sm:hidden">
        <Icon icon={Tag} />
        Latest: {c.version}
        <Arrow way="out" />
      </a>
    </div>
    <p class="t-lede mt-6 max-w-2xl">{c.tagline}</p>
    <p class="mt-8 grid gap-3 sm:flex sm:flex-wrap sm:items-center sm:gap-x-5">
      <a href={repo} class="btn-primary group justify-center">
        <Icon icon={CodeXml} />
        Source on GitHub
        <Arrow way="out" />
      </a>
      {
        c.docs && (
          <a href={c.docs} class="btn group justify-center">
            <Icon icon={BookOpen} />
            Documentation
            <Arrow way="out" />
          </a>
        )
      }
      <a href={opamUrl(c)} class="link group hidden items-center gap-1.5 sm:inline-flex">
        <Icon icon={Tag} />
        Latest: {c.version}
        <Arrow way="out" />
      </a>
    </p>
  </TitleBand>

  {/* What it is, then how to get it: the margin names each part. */}
  <Section id="about" rail="About" class="theme-light">
    <div class={row}>
      <h2 class="t-label pt-1.5 text-graphite">About</h2>
      <div class="max-w-[32rem] space-y-4 leading-relaxed">
        {
          c.about.map((p) => (
            <p>
              {runs(p).map((r) =>
                typeof r === "string" ? (
                  r
                ) : (
                  <a href={r.href} target="_blank" rel="noopener" class="link-inline group">
                    {r.text}
                    <Arrow way="out" class="ml-0.5 inline size-[0.8em] align-[-0.05em]" />
                  </a>
                ),
              )}
            </p>
          ))
        }
        {
          capabilities.length > 0 && (
            <p class="flex flex-wrap gap-2 pt-2">
              {capabilities.map((g) => (
                <a href={`/stack/#cap-${g.id}`} class="t-control rounded-full border border-rule px-3 py-1 text-graphite transition-colors hover:border-graphite hover:text-ink">
                  {g.name}
                </a>
              ))}
            </p>
          )
        }
      </div>
    </div>
    <div class:list={[row, "mt-14"]}>
      <h2 class="t-label pt-1.5 text-graphite">Install</h2>
      <div class="min-w-0 max-w-3xl space-y-4">
        <p class="leading-relaxed text-graphite">From <a href="https://open-opam.org/" target="_blank" rel="noopener" class="link-inline">open-opam</a>, on OCaml 5.5 or later:</p>
        <Code code={install(c)} lang="shellscript" theme={codeTheme} class={code} />
        <p class="leading-relaxed text-graphite">Then in your <code class="font-mono text-sm text-ink">dune</code> file:</p>
        <Code code={c.dune} lang="lisp" theme={codeTheme} class={code} />
      </div>
    </div>
  </Section>

  <Section id="in-code" rail="In code">
      <div class={row}>
        <h2 class="t-label pt-1.5 text-graphite">In code</h2>
        <ol class="min-w-0 max-w-3xl space-y-10">
          {
            c.snippets.map((s) => (
              <li class="space-y-4">
                <p class="leading-relaxed text-graphite">{s.caption}</p>
                <Code code={s.code} lang={s.lang as never} theme={codeTheme} class={code} />
              </li>
            ))
          }
        </ol>
      </div>
  </Section>

  <Closing />
</Base>
