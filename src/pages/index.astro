---
import Base from "../layouts/Base.astro";
import Paths from "../components/Paths.astro";
import { ways } from "../content/ways";
import Chladni from "../components/Chladni.astro";
import Plate from "../components/Plate.astro";
import TemplateRouter from "../components/TemplateRouter.astro";
import Icon from "../components/Icon.astro";
import Layers from "@lucide/astro/icons/layers";
import ScrollText from "@lucide/astro/icons/scroll-text";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";

/* The landing says why; Stack's page says how, so no OCaml and no
   library list here.

   hero        what Hypha is; no lede
   shift       AI has solved coding, not engineering: a smarter model
               still guesses where meaning is unstated
   principle   strong boundaries: people specify, the system enforces
   answer      Hypha Stack, and how work goes on it in four steps
   start       the ways in; nothing after them

   No promises, dates or roadmap; nothing promises correct software.
   Agents are never the culprit and no language is attacked. */

/* Footnotes: each source says what it measured, so its figure is not
   read for more. Evidence, never the argument. */
const reading = [
  {
    what: "Logic and correctness issues were 75% more common in AI-co-authored pull requests.",
    limit: "470 open-source pull requests, 320 AI-co-authored and 150 human-only, with authorship inferred from signals in each PR.",
    by: "CodeRabbit",
    title: "State of AI vs human code generation report",
    year: "2025",
    href: "https://www.coderabbit.ai/blog/state-of-ai-vs-human-code-generation-report",
  },
  {
    what: "As AI adoption increased, delivery stability fell by an estimated 7.2%.",
    limit: "A survey-based association across teams, not a measured cause.",
    by: "Google Cloud",
    title: "Announcing the 2024 DORA report",
    year: "2024",
    href: "https://cloud.google.com/blog/products/devops-sre/announcing-the-2024-dora-report",
  },
];

/* What happens at each step, never how. Only Composition claims checks:
   only there does the stack enforce them. */
const steps = [
  { title: "Intent", body: "People say what the product must do, and agents question it until nothing is left to interpret." },
  { title: "Mapping", body: "The work is laid over one model of a backend: what is already built and proven, and what is the product's own." },
  { title: "Composition", body: "Agents build with components made to fit together, held by checks on every change." },
  { title: "Delivery", body: "Each change lands complete, with its tests and its documents." },
];

---

<Base
  title="Hypha · The missing foundation for agentic engineering"
  description="The missing foundation for agentic engineering. AI has solved coding, not engineering: Hypha Stack is sound by design."
>
  {/* The hero: words at the band's foot, the figure above them. */}
  <section slot="band" class="relative">
    <Chladni />
    <div
      class="relative mx-auto flex min-h-[max(34rem,calc(100svh-var(--masthead)))] max-w-page flex-col justify-end px-4 pt-32 pb-20 sm:px-6 md:pb-28"
      data-content
    >
      <h1 class="t-hero max-w-5xl md:ml-margin" data-clear>
        The missing foundation
        <br />
        <span class="text-accent">for agentic engineering.</span>
      </h1>
      <div class="mt-10 flex flex-wrap gap-3 md:mt-12 md:ml-margin" data-clear data-actions>
        <a href="/stack" class="btn-primary"><Icon icon={Layers} />Explore Hypha Stack</a>
        <a href="/principles" class="btn"><Icon icon={ScrollText} />Read the principles</a>
      </div>
    </div>
  </section>

  {/* The shift and its cause, in one section. Sources are footnotes
      under the paragraph they support. Nothing is drawn as a queue or a
      sieve; correctness is not throughput. */}
  <section id="shift" class="scroll-mt-8 border-t border-rule">
    <div class="mx-auto max-w-page px-4 py-16 sm:px-6 md:py-20">
      <div class="md:ml-margin">
        <h2 class="t-h1 max-w-4xl"><span class="block">AI has solved coding.</span> <span class="block">Not engineering.</span></h2>
        <p class="t-lede mt-8 max-w-2xl text-graphite">
          Code is cheap. Software that holds is not. Agents build a feature
          in minutes, but every request leaves room for interpretation, and
          an agent sees only part of the system. It fills that room with
          choices of its own, each reasonable, none bound to agree with the
          next.
        </p>
        <p class="mt-6 max-w-2xl leading-relaxed text-graphite">
          A smarter model guesses better, but it still guesses, and every
          choice waits on a person. The review that follows is slow, with
          feedback and test runs at every turn, and too shallow to trust:
          changes are merged blindly to keep up. Another reviewer, human or
          AI, only arrives once the code exists. What it finds gets patched,
          but never narrows the next one. With nothing holding those choices
          together, a product becomes a patchwork that gives way at its
          seams, and every outage costs traffic, customers and trust.<sup class="t-footmark">{reading.map((_, i) => (
            <Fragment>{i > 0 && ","}<a href={`#note-${i + 1}`} id={`ref-${i + 1}`} class="scroll-mt-32" aria-label={`Note ${i + 1}`}>{i + 1}</a></Fragment>
          ))}</sup>
        </p>
        <ol class="t-footnote mt-12 grid max-w-4xl gap-x-10 gap-y-5 md:grid-cols-2">
          {
            reading.map((r, i) => (
              <li id={`note-${i + 1}`} class="grid scroll-mt-8 grid-cols-[1.25rem_minmax(0,1fr)]">
                {/* Leads back to the note's mark in the text. */}
                <a
                  href={`#ref-${i + 1}`}
                  class="t-backmark self-start justify-self-start font-serif tabular-nums"
                  aria-label={`Back to note ${i + 1} in the text`}
                >
                  {i + 1}
                </a>
                <p>
                  <span class="text-ink">{r.what}</span> {r.limit} {r.by},{" "}
                  <a href={r.href} class="link-inline group">{r.title}<Icon icon={ArrowUpRight} class="ml-0.5 inline size-[0.8em] align-[-0.05em] transition-transform duration-300 ease-glide group-hover:translate-x-0.5 group-hover:-translate-y-0.5" /></a>, {r.year}.
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* The principle. The template router over the pair draws it: the
      arm takes its own path every pass, and the bushing never leaves
      the template's gold-edged opening, so every pocket comes out the
      same. The gold line between the pair is the boundary. It stands on
      the dotted ground the Principles title does. */}
  <section id="boundaries" class="relative scroll-mt-8 overflow-hidden border-t border-rule">
    <div class="dotted pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_70%_75%_at_50%_50%,black_30%,transparent_100%)]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-page px-4 py-16 sm:px-6 md:py-20">
      <div class="md:ml-margin">
        <h2 class="t-h1 max-w-4xl">Strong boundaries make systems sound.</h2>
        <p class="t-lede mt-8 max-w-2xl text-graphite">
          A boundary is meaning an agent no longer has to guess: what each
          thing is, what it may touch, what it must return. It lives in the
          foundation and is checked on every change.
        </p>
        <TemplateRouter class="mt-12" />
        <dl class="mt-12 grid gap-y-8 md:grid-cols-[auto_1px_auto] md:justify-start md:gap-x-12">
          <div>
            <dt class="t-h2">People specify</dt>
            <dd class="mt-3 max-w-sm leading-relaxed text-graphite">
              What the product must do, in their own words.
            </dd>
          </div>
          <div aria-hidden="true" class="h-px w-full bg-accent forced-colors:bg-[CanvasText] forced-colors:forced-color-adjust-none md:h-auto md:w-px"></div>
          <div>
            <dt class="t-h2">The system enforces</dt>
            <dd class="mt-3 max-w-sm leading-relaxed text-graphite">
              How it must be done: every part held to its contract.
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {/* The answer, set as the hero is, over sand on a round plate. Each
      new figure of its sand moves the steps on by one, and a line draws
      over the step while the sand settles. */}
  <section id="stack" class="relative scroll-mt-8 overflow-hidden border-t border-rule">
    <Plate />
    <div
      class="relative mx-auto flex min-h-[max(34rem,88svh)] max-w-page flex-col justify-end px-4 pt-32 pb-20 sm:px-6 md:pb-28"
      data-content
    >
      <h2 class="t-hero max-w-5xl md:ml-margin" data-clear><span class="block">Hypha Stack:</span> <span class="block text-accent">sound by design.</span></h2>
      <p class="t-lede mt-8 max-w-2xl text-graphite md:mt-10 md:ml-margin" data-clear>
        Components built to fit together, an ontology that says what each
        part means, a language that makes it binding, and practices that
        hold the boundaries.
      </p>
      <ol class="steps mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2 md:ml-margin lg:grid-cols-4" data-clear data-steps>
        {
          steps.map((s) => (
            <li class="relative pt-5">
              <h3 class="t-h3">{s.title}</h3>
              <p class="mt-2 leading-relaxed text-graphite">{s.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-12 flex flex-wrap gap-3 md:ml-margin" data-clear>
        <a href="/stack" class="btn-primary"><Icon icon={Layers} />Explore Hypha Stack</a>
      </div>
    </div>

  </section>

  {/* The ways in: a conversation, the code, the Principles. */}
  <section id="start" class="scroll-mt-8 border-t border-rule">
    <div class="mx-auto max-w-page px-4 pt-16 pb-4 sm:px-6 md:pt-20 md:pb-8">
      <h2 class="t-h1 max-w-4xl md:ml-margin">Build with Hypha.</h2>
      <Paths paths={ways} />
    </div>
  </section>

</Base>

<style>
  /* Every step stands on a rule; the step in play draws its own over
     it as the sand settles, and lets it go faster than it came. */
  .steps > li::before,
  .steps > li::after {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
  }
  .steps > li::before {
    background: var(--color-rule);
  }
  .steps > li::after {
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 400ms var(--ease-state);
  }
  .steps > li.is-now::after {
    transform: scaleX(1);
    transform-origin: left;
    transition: transform 2400ms var(--ease-glide);
  }
  .steps.is-live h3 {
    color: var(--color-graphite);
    transition: color 600ms var(--ease-state);
  }
  .steps.is-live > li.is-now h3 {
    color: var(--color-ink);
  }
  /* Forced colours flatten fills to the ground: the rules take system
     colours, the step in play the highlight. */
  @media (forced-colors: active) {
    .steps > li::before,
    .steps > li::after {
      forced-color-adjust: none;
    }
    .steps > li::before {
      background: GrayText;
    }
    .steps > li::after {
      background: Highlight;
    }
  }
</style>

<script>
  /* The steps keep time with the plate behind them: a figure each. A
     hovered step holds until the pointer leaves. With reduced motion the
     plate holds one frame and the steps stay as written. */
  const list = document.querySelector<HTMLElement>("[data-steps]");
  const plate = list?.closest("section")?.querySelector<HTMLElement>("[data-plate]");
  if (list && plate && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const items = [...list.children] as HTMLElement[];
    let figure = 0;
    let held: number | null = null;
    const show = () => {
      const now = held ?? figure % items.length;
      items.forEach((item, i) => item.classList.toggle("is-now", i === now));
    };
    plate.addEventListener("figure", (event) => {
      figure = (event as CustomEvent<number>).detail;
      list.classList.add("is-live");
      show();
    });
    items.forEach((item, i) => {
      item.addEventListener("pointerenter", () => {
        held = i;
        show();
      });
      item.addEventListener("pointerleave", () => {
        held = null;
        show();
      });
    });
  }
</script>
