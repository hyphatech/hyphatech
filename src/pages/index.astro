---
import { organization, website } from "../lib/schema";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Opener from "../components/Opener.astro";
import Chladni from "../components/Chladni.astro";
import JigBoard from "../components/JigBoard.astro";
import Icon from "../components/Icon.astro";
import Arrow from "../components/Arrow.astro";
import Factory from "@lucide/astro/icons/factory";
import Layers from "@lucide/astro/icons/layers";
import Braces from "@lucide/astro/icons/braces";
import Blocks from "@lucide/astro/icons/blocks";
import Network from "@lucide/astro/icons/network";
import Hourglass from "@lucide/astro/icons/hourglass";
import Gem from "@lucide/astro/icons/gem";
import PenLine from "@lucide/astro/icons/pen-line";
import BookOpen from "@lucide/astro/icons/book-open";
import Hammer from "@lucide/astro/icons/hammer";
import Closing from "../components/Closing.astro";
import Compare from "../components/Compare.astro";
import { ways } from "../content/ways";

/* The landing sells Hypha whole, in the order a visitor asks:

   top         what Hypha is, its title alone over the sand: no lede, as
               a line under the title that restates it explains a
               picture of two cats, and no buttons, as the rail and the
               close send each reader on
   shift       the positioning: coding is solved, engineering is not,
               beside two sourced figures
   boundaries  the principle: strong boundaries make systems sound,
               drawn as a template router
   factory     Hypha, sound by design: the four levels as a map over the
               sand on the plate, the Factory in gold where they meet,
               picking up the word the boundaries section's title ends on
   durable     what Hypha buys: durable software at agent speed, against
               the disposable kind, compared in two panels
   build       build with Hypha: talk to us, modernise the system that
               runs, or explore the Factory

   One story, not two: Hypha works only whole, and the Factory is what a
   reader comes away with. The Factory is spelt out on the landing, never
   HAF. No promises, dates, prices or roadmap; nothing of how. Agents are
   never the culprit and no language is attacked. Nothing addressed to
   the reader in the sections: the copy says the thing, it does not point
   at it. */

/* The figures beside the shift: each says what it measured, so its
   number is not read for more. Evidence, never the argument. */
const reading = [
  {
    number: "75%",
    what: "more logic and correctness issues in AI-co-authored pull requests",
    limit: "470 open-source pull requests, 320 AI-co-authored and 150 human-only, with authorship inferred from signals.",
    by: "CodeRabbit",
    title: "State of AI vs human code generation report",
    year: "2025",
    href: "https://www.coderabbit.ai/blog/state-of-ai-vs-human-code-generation-report",
  },
  {
    number: "7.2%",
    what: "less delivery stability, by estimate, as AI adoption increased",
    limit: "A survey-based association across teams, not a measured cause.",
    by: "Google Cloud",
    title: "Announcing the 2024 DORA report",
    year: "2024",
    href: "https://cloud.google.com/blog/products/devops-sre/announcing-the-2024-dora-report",
  },
];

/* Disposable against durable, the same product after many changes, in
   one panel: who builds each and how it holds, and the outcome. */
const kinds = {
  rows: ["A change", "Checked by", "Documented", "Lasts"],
  before: {
    name: "Disposable",
    icon: Hourglass,
    note: "built by agents alone",
    values: ["Guessed again, where nothing was stated", "Whoever reads the diff", "By whoever remembers", "Until someone proposes a rewrite"],
    story: "Fast to write, and fragile from the start.",
  },
  after: {
    name: "Durable",
    icon: Gem,
    note: "built with Hypha",
    values: ["Agreed before it is built", "Checks nothing skips", "Always as it is", "For years"],
    story: "Fast to write, and holds together as it grows.",
  },
};

/* Hypha's four levels as a map, each relation named: the Components
   are written in the Language, described by the Ontology, and the
   Factory builds from the Ontology. The Factory, where the levels meet,
   is the one in gold. What each is, never how. Read in the map's order:
   top left, top right, bottom left, bottom right. */
const levels = [
  { title: "Language", icon: Braces, body: "What it cannot say, the system cannot get wrong.", hypha: false },
  { title: "Components", icon: Blocks, body: "Made to fit together, built and proven once.", hypha: false },
  { title: "Factory", icon: Factory, body: "The autonomous line from your decisions to a tested release.", hypha: true },
  { title: "Ontology", icon: Network, body: "The shared meaning of every part, and of how the parts relate.", hypha: false },
];

---

<Base
  title="Hypha · The missing foundation for agentic engineering"
  description="The missing foundation for agentic engineering: the Stack you build with, and the Factory that builds on its own once you have signed what it must do."
  schema={{ "@graph": [website, organization] }}
>
  {/* The hero: words at the band's foot, the figure above them, the
      sand moving over Ember. On a phone it stops short of the screen's
      foot, so the paper after it shows the page goes on. */}
  <section slot="band" id="top" data-rail-name="The missing foundation" class="theme-ember relative overflow-hidden -mt-(--masthead) pt-(--masthead)">
    <div class="k-grain" aria-hidden="true"></div>
    <Chladni />
    <div
      class="relative mx-auto flex min-h-[max(28rem,calc(80svh-var(--masthead)))] md:min-h-[max(34rem,calc(100svh-var(--masthead)))] max-w-page flex-col justify-end px-4 pt-32 pb-12 sm:px-6 md:pb-16"
      data-content
    >
      <h1 class="t-hero max-w-5xl" data-clear>
        The missing foundation
        <br />
        <span class="text-accent">for agentic engineering.</span>
      </h1>
    </div>
  </section>

  {/* The shift and its cause, beside the two figures that bear it out,
      each with what it measured and its source. Nothing is drawn as a
      queue or a sieve; correctness is not throughput. On paper, as the
      kit sets figures. */}
  <Section id="shift" rail="Coding is solved" class="theme-light">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div>
        <Opener title={["Coding is solved.", "Engineering is not."]}>
          <p>
            A model is fuzzy by nature. It writes the most likely code for
            what it is asked and makes its own choices about the rest, and
            better prompts only make it guess better.
          </p>
          <p>
            The faster agents write, the faster those choices pile up into
            a patchwork with nothing holding it together, and every outage
            costs traffic, customers and trust.
          </p>
        </Opener>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          reading.map((r) => (
            <li class="flex">
              <a href={r.href} class="k-figure k-figure-link flex w-full flex-col">
                <p class="k-figure-number">{r.number}</p>
                <p class="mt-4">{r.what}</p>
                <p class="mt-3 text-balance text-sm text-graphite">{r.limit}</p>
                <p class="mt-auto pt-4 text-sm text-graphite">
                  <span class="k-figure-source">{r.by}, {r.year}</span><Arrow way="out" class="ml-1 inline size-[0.8em] align-[-0.05em]" />
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  {/* The principle, drawn as a template router: the arm takes its own
      path every pass, and the bushing never leaves the template's
      gold-edged opening. People specify, and the system enforces. The
      section stands on the dotted ground the Principles title does. */}
  <Section id="boundaries" rail="Strong boundaries">
    {/* The jig is the section's subject and the page's: it is set at the
        page's full width under the lede, on fine dots edge to edge,
        unframed, a warm light rising behind it; the levels after it
        stand on a framed plate, so the two never repeat one card. The
        section opens as every other, the heading with its lede under it.
        The drawing's box keeps room for the arm under the jig, so the
        field reaches into the section's foot, and Hypha's plate stands
        as far under the jig as the jig stands under the lede. */}
    {/* Side by side only where the heading keeps its two lines (its gold
        line is 479px at 48px, and half of 72rem leaves 528px); below,
        the jig follows the opener. */}
    <div class="grid items-center gap-12 xl:grid-cols-2">
      <div>
        <Opener title={["Strong boundaries", "make systems sound."]} mark>
          A boundary tells an agent what each thing is, what it may touch and what it must return, so nothing is left to guess. Where an instruction can be ignored, a boundary holds.
        </Opener>
      </div>
      <div class="mx-auto w-full max-w-[40rem] xl:max-w-none"><JigBoard /></div>
    </div>
  </Section>

  {/* Hypha and what it builds, after the boundaries, and the page's
      climax. The levels lie on the plate; under it, on the page's line as
      the plate's frame and every section are, disposable against durable, its heading over its lede as every
      section opens, the same product after many changes,
      a block of information after Hypha is shown, never a choice Hypha
      offers, its heading and lede on the levels' two columns. Then:
      the one section off night and paper, on Ember, its heading at the
      hero's scale beside the four levels, centred on one axis, its ways
      in under its line. The heading picks up the word the
      boundaries section's title ends on. */}
  {/* The plate is a frame of its own, so it stands as far under the jig
      as the jig under the section's top: the boundaries' padding alone,
      the 12px its corner marks reach out borrowed back. */}
  <section id="factory" data-rail-name="Sound by design" class="theme-ember relative -mt-3 scroll-mt-8 overflow-hidden">
    <div class="k-grain" aria-hidden="true"></div>
    <div class="k-fade-head" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-page px-4 pt-3 pb-16 sm:px-6">
      <div class="k-plate px-4 py-12 sm:px-6 md:px-12 md:py-16 xl:-mx-12">
        <span class="k-mark k-mark-tl" aria-hidden="true"></span>
        <span class="k-mark k-mark-tr" aria-hidden="true"></span>
        <span class="k-mark k-mark-bl" aria-hidden="true"></span>
        <span class="k-mark k-mark-br" aria-hidden="true"></span>
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <div>
          <h2 class="t-hero lg:text-6xl">Hypha: <span class="block text-accent lg:whitespace-nowrap">sound by design.</span></h2>
          <p class="t-lede mt-8 max-w-xl">
            A coherent foundation, from the language up.
            <span class="block">Deterministic where possible, intelligent where necessary.</span>
          </p>
          <p class="mt-10 flex gap-3">
            <a href="/haf/" class="btn-primary"><Icon icon={Factory} />The Factory</a>
            <a href="/stack/" class="btn"><Icon icon={Layers} />The Stack</a>
          </p>
        </div>
        {/* The four levels on a strict grid, each a panel as the
            comparison's are, its icon and name in the header line and its sentence
            in the well; each relation in the cell between two, and the
            Factory, where they meet, with the gold edge. */}
        <div class="k-map">
          {
            levels.map((l, i) => (
              <Fragment>
                <div class:list={["k-panel k-panel-card", l.hypha && "k-panel-hypha"]}>
                  <p class="k-panel-head"><span class="k-panel-name inline-flex items-center gap-2"><Icon icon={l.icon} />{l.title}</span></p>
                  <p class="k-panel-well k-panel-row flex-1">{l.body}</p>
                </div>
                {i === 0 && <div class="k-relation k-relation-h"><span class="k-badge" role="img" aria-label="written in" title="written in"><PenLine size={15} stroke-width={1.6} aria-hidden="true" /></span></div>}
                {i === 1 && (
                  <Fragment>
                    <div />
                    <div />
                    <div class="k-relation k-relation-v"><span class="k-badge" role="img" aria-label="described by" title="described by"><BookOpen size={15} stroke-width={1.6} aria-hidden="true" /></span></div>
                  </Fragment>
                )}
                {i === 2 && <div class="k-relation k-relation-h"><span class="k-badge" role="img" aria-label="builds from" title="builds from"><Hammer size={15} stroke-width={1.6} aria-hidden="true" /></span></div>}
              </Fragment>
            ))
          }
        </div>
      </div>
      </div>
      <div id="durable" data-rail-name="Durable software" class="mt-12 scroll-mt-8 md:mt-16">
        <h2 class="t-h1">Build durable software <span class="block">at the speed of agents.</span></h2>
        <p class="t-lede mt-6 max-w-2xl">
          Models made code cheap, and most of it is disposable. Hypha is built for durable products that grow fast, without trading speed for quality.
        </p>
        <Compare class="mt-12" {...kinds} />
      </div>
    </div>
  </section>

  <Closing paths={ways} />

</Base>
