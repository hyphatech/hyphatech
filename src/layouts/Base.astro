---
import Wordmark from "../components/Wordmark.astro";
import Mark from "../components/Mark.astro";
import "../styles/site.css";
/* Preloaded: every page opens in the slab, and the moving bands wait for
   it before they measure. */
import slab from "@fontsource-variable/roboto-slab/files/roboto-slab-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /* The last section meets the footer with no gap. */
  flush?: boolean;
  /* The 404: noindex, no canonical. */
  lost?: boolean;
}

const { title, description, flush = false, lost = false } = Astro.props;
/* A page with an opening band draws the masthead inside it, unruled. */
const banded = Astro.slots.has("band");
const canonical = new URL(Astro.url.pathname, Astro.site);
/* Pages are served as directories ("/stack/"): drop the trailing slash
   before matching a nav link. */
const path = Astro.url.pathname.replace(/(.)\/$/, "$1");

const nav = [
  { label: "Hypha Stack", href: "/stack" },
  { label: "Principles", href: "/principles" },
  { label: "GitHub", href: "https://github.com/hyphatech" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preload" href={slab} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {lost ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#15120E" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hypha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* One share card for every page, rendered from the hero. */}
    <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The missing foundation for agentic engineering." />
    <meta name="twitter:card" content="summary_large_image" />

  </head>

  <body class="min-h-dvh bg-ivory text-ink">
    <div>
    <header class:list={["relative", !banded && "border-b border-rule"]}>
      <div class="mx-auto flex h-16 max-w-page items-center gap-6 px-4 sm:px-6">
        <Wordmark />
        <nav class="ml-auto hidden items-center gap-6 md:flex" aria-label="Site">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={path === item.href ? "page" : undefined}
                class:list={[
                  "t-control tap transition-colors hover:text-ink",
                  path === item.href ? "text-ink" : "text-graphite",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        {/* Phone menu: a <details>, so it opens without JavaScript. */}
        <details class="group ml-auto md:hidden" data-menu>
          <summary
            class="t-control -mr-3 flex h-11 cursor-pointer list-none items-center px-3 text-graphite transition-colors hover:text-ink group-open:text-ink [&::-webkit-details-marker]:hidden"
          >
            <span class="group-open:hidden">Menu</span>
            <span class="hidden group-open:inline">Close</span>
          </summary>
          <nav
            class="absolute inset-x-0 top-16 z-10 border-y border-rule bg-ivory px-4 pb-6 sm:px-6"
            aria-label="Site"
          >
            <ul>
              {
                nav.map((item) => (
                  <li class="border-b border-rule last:border-b-0">
                    <a
                      href={item.href}
                      aria-current={path === item.href ? "page" : undefined}
                      class:list={[
                        "t-h3 flex min-h-14 items-center transition-colors hover:text-ink",
                        path === item.href ? "text-ink" : "text-graphite",
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <slot name="band" />
    </div>

    <main>
      <slot />
    </main>

    <div class:list={[!flush && "mt-24"]}>
    <footer class="border-t border-rule">
      <div class="mx-auto grid max-w-page gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1fr_auto] md:gap-16">
        <div class="max-w-lg">
          <div class="flex items-center gap-2">
            <Mark class="h-6" />
            <span class="text-base leading-none font-medium">hypha</span>
          </div>
          {/* Required by the trading disclosure rules. The year is the
              build's. */}
          <p class="t-caption mt-4 text-graphite">
            <span class="block">
              © {new Date().getFullYear()} Hypha Technologies Ltd. Registered in
              England and Wales, no.&nbsp;16665133.
            </span>
            <span class="block">Registered office: 86–90&nbsp;Paul Street, London EC2A&nbsp;4NE.</span>
          </p>
        </div>
        <ul class="t-control space-y-3 text-graphite pointer-coarse:space-y-0">
          <li><a class="tap transition-colors hover:text-ink" href="/stack">Hypha Stack</a></li>
          <li><a class="tap transition-colors hover:text-ink" href="/principles">Principles</a></li>
          <li><a class="tap transition-colors hover:text-ink" href="https://github.com/hyphatech">GitHub</a></li>
        </ul>
      </div>
    </footer>
    </div>
    <script>
      /* Close the phone menu on Escape, a tap outside, or any link
         followed, in-page ones included. */
      for (const menu of document.querySelectorAll<HTMLDetailsElement>("[data-menu]")) {
        const close = () => (menu.open = false);
        menu.addEventListener("click", (event) => {
          if ((event.target as Element).closest("a")) close();
        });
        document.addEventListener("click", (event) => {
          if (menu.open && !menu.contains(event.target as Node)) close();
        });
        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || !menu.open) return;
          close();
          menu.querySelector("summary")?.focus();
        });
      }
    </script>
  </body>
</html>
