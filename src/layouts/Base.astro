---
import Wordmark from "../components/Wordmark.astro";
import Mark from "../components/Mark.astro";
import Icon from "../components/Icon.astro";
import Layers from "@lucide/astro/icons/layers";
import Compass from "@lucide/astro/icons/compass";
import Newspaper from "@lucide/astro/icons/newspaper";
import CodeXml from "@lucide/astro/icons/code-xml";
import "../styles/site.css";
/* Preloaded: every page opens in the slab, and the moving bands wait for
   it before they measure. */
import slab from "@fontsource-variable/roboto-slab/files/roboto-slab-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /* The last section meets the footer with no gap. */
  flush?: boolean;
  /* The 404: noindex, no canonical. */
  lost?: boolean;
}

const { title, description, flush = false, lost = false } = Astro.props;
/* A page with an opening band draws the masthead inside it, unruled. */
const banded = Astro.slots.has("band");
const canonical = new URL(Astro.url.pathname, Astro.site);
/* Pages are served as directories ("/stack/"): drop the trailing slash
   before matching a nav link. */
const path = Astro.url.pathname.replace(/(.)\/$/, "$1");
/* A component's page (/stack/spindle) is within Hypha Stack. */
const within = (href: string) => path === href || path.startsWith(`${href}/`);

const nav = [
  { label: "Hypha Stack", href: "/stack", icon: Layers },
  { label: "Principles", href: "/principles", icon: Compass },
  { label: "Blog", href: "https://hypha.pub/", icon: Newspaper },
  { label: "GitHub", href: "https://github.com/hyphatech", icon: CodeXml },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preload" href={slab} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {lost ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#15120E" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hypha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* One share card for every page, rendered from the hero. */}
    <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The missing foundation for agentic engineering." />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline async src="https://cloud.umami.is/script.js" data-website-id="a3f870a5-b958-4bf7-afa4-8f26c1c7fff7" data-domains="hyphatech.io"></script>
  </head>

  <body class="min-h-dvh bg-ivory text-ink">
    {/* The first stop for the keyboard, past the masthead; unseen until
        it has focus. */}
    <a href="#main" class="btn-primary absolute top-3 left-4 z-10 -translate-y-24 focus-visible:translate-y-0 sm:left-6">Skip to content</a>
    <div>
    <header class:list={["relative", !banded && "md:border-b md:border-rule"]}>
      <div class="mx-auto flex h-16 max-w-page items-center gap-6 px-4 sm:px-6">
        <Wordmark />
        <nav class="ml-auto hidden items-center gap-6 md:flex" aria-label="Site">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={path === item.href ? "page" : within(item.href) ? "true" : undefined}
                class:list={[
                  "t-control tap inline-flex items-center gap-2 transition-colors hover:text-ink",
                  within(item.href) ? "text-ink" : "text-graphite",
                ]}
              >
                <Icon icon={item.icon} />
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
      {/* On a phone the same links stand in a row under the masthead;
          the page you are on is on `raised`. Too wide for the screen, the
          row scrolls under a finger, with no bar drawn under it. */}
      <nav class="border-y border-rule md:hidden" aria-label="Site">
        <ul class="mx-auto flex max-w-page gap-0.5 overflow-x-auto px-1.5 [scrollbar-width:none] min-[22.5rem]:gap-1 min-[22.5rem]:px-2 py-2 sm:px-4 [&::-webkit-scrollbar]:hidden">
          {
            nav.map((item) => (
              <li class="shrink-0">
                <a
                  href={item.href}
                  aria-current={path === item.href ? "page" : within(item.href) ? "true" : undefined}
                  class="nav-item gap-1.5 px-2 py-2.5 min-[22.5rem]:gap-2 min-[22.5rem]:px-3"
                >
                  <Icon icon={item.icon} />
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    </div>

    {/* The band is the page's opening, so it is in `main` with the rest:
        skipping the masthead lands on it. */}
    <main id="main" tabindex="-1" class="outline-none">
      <slot name="band" />
      <slot />
    </main>

    <div class:list={[!flush && "mt-24"]}>
    <footer class="border-t border-rule">
      <div class="mx-auto grid max-w-page gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1fr_auto] md:gap-16">
        <div class="max-w-lg">
          <div class="flex items-center gap-2">
            <Mark class="h-6" />
            <span class="text-base leading-none font-medium">hypha</span>
          </div>
          {/* Required by the trading disclosure rules. The year is the
              build's. */}
          <p class="t-caption mt-4 text-graphite">
            <span class="block">
              © {new Date().getFullYear()} Hypha Technologies Ltd. Registered in
              England and Wales, no.&nbsp;16665133.
            </span>
            <span class="block">Registered office: 86–90&nbsp;Paul Street, London EC2A&nbsp;4NE.</span>
            <span class="mt-3 block">Made in London.</span>
          </p>
        </div>
        <ul class="t-control space-y-3 text-graphite pointer-coarse:space-y-0">
          {
            nav.map((item) => (
              <li>
                <a class="tap inline-flex items-center gap-2 transition-colors hover:text-ink" href={item.href}>
                  <Icon icon={item.icon} />
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
    </div>
  </body>
</html>
