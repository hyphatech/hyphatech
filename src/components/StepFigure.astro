---
/* A step of the Factory as HAF's own screen shows it, live, in HAF's
   panes and palette and the design its meters lab settled. The left
   pane is where a person works: the talk, the lists, the cursor. The
   right pane is what stands beside it: the steps as six segments with
   the one at work named over them, htop's meters coloured by role, the
   details of what the cursor is on, the logs. ⏺ marks what is going on,
   a step, a stage, a service; a spinner what runs this second, a gate,
   a scenario, a build.
   Each plays the sample task tracker's run (hypha-haf's
   examples/task-tracker), filling its figure edge to edge.

   Intent       the questions one at a time, the model thinking between,
                one answered in your own words, then the PRD drafted,
                read and signed
   Mapping      the plan, computed at once and read item by item, each
                one's lookup and the plan's meters beside it
   Scaffold     the application's parts and the scaffold its shape
                takes, laid and built before any model is called
   Composition  a stage's items, the gates on the one at work, one refused
                and tried again, the budget beside them
   Validation   each requirement proven, scenario by scenario, on the
                running service
   Release      released, tagged and pushed, then the Workbench running it

   The questions, the PRD, the requirements, scenarios and the release
   are the run's own. The items past those the docs print, the lookups,
   meters, numbers and logs are an example. One clock plays a figure
   while it is in view and loops: `data-at` shows an element from its
   second and `data-until` takes it away, `data-seq` steps its state,
   `data-type` types it, `data-roll` scrolls it as a reader would. What
   grows fills from its top and keeps its last line in view, as a
   terminal does. The markup stands at the loop's end, so reduced motion
   and no script show the whole step. */

interface Props {
  step: string;
  label: string;
}
const { step, label } = Astro.props;

/* A sequence's last state, the one the markup stands in. */
const fin = (s: string) => s.trim().split(/\s+/).at(-1)!.split(":").slice(1).join(":");
const seq = (s: string) => ({ "data-seq": s, "data-state": fin(s) });
const f2 = (n: number) => n.toFixed(2);

/* The six steps as segments: those done, the one at work, and, from
   second `next`, the one after it at work instead. */
const stepNames = ["Intent", "Mapping", "Scaffold", "Composition", "Validation", "Release"];
const segs = (n: number, next?: number) =>
  stepNames.map((_, i) =>
    i < n ? "0:done" : i === n ? (next === undefined ? "0:now" : `0:now ${f2(next)}:done`) : i === n + 1 && next !== undefined && n + 1 < stepNames.length ? `0:wait ${f2(next)}:now` : "0:wait",
  );
const cells = 24;
/* A meter's cells: the first `lit` of them shown, each from its second. */
const bar = (lit: (number | true)[]) => Array.from({ length: cells }, (_, i) => lit[i]);

/* ---------- Intent ---------- */
const questions = [
  { q: "Can a done task be reopened?", why: "It decides a task's states and who may act on it.", opts: ["Yes, by its assignee or its owner.", "No", "In my own words"], answer: "Yes, by its assignee or its owner.", think: "A reopened task goes back to open, so a task is open, done or reopened. Whether a due date may lie in the past decides a rule." },
  { q: "A task due in the past: refuse it, or accept it as overdue?", why: "It decides the rule a due date is held to.", opts: ["Refuse it.", "Accept it, marked overdue."], answer: "Refuse it.", think: "The reminder is a job that runs on its own. When it runs is the person's to say." },
  { q: "When is the reminder sent?", why: "It decides the job that sends it, and when it runs.", opts: ["A day before it is due.", "An hour before it is due.", "In my own words"], answer: "A day before, at 09:00 in the assignee's time.", own: true, think: "" },
];
const asks = (() => {
  let t = 0.6;
  return questions.map((q) => {
    const at = t;
    const off = at + (q.own ? 4.2 : 2.4);
    const thinkUntil = q.think ? off + 2.4 : off;
    t = thinkUntil + 0.2;
    return { ...q, at, off, thinkUntil };
  });
})();
const drafting = asks.at(-1)!.off + 0.3;
const drafted = drafting + 1.6;
const reading = drafted + 0.6;
const read = reading + 6.5;
const signed = read + 1.6;
const intentLoop = signed + 3.2;
const prd = {
  problem: "A small team keeps its tasks in a chat thread, and nobody knows what is due, who has it, or what is done. They want an API their own tools call: projects of tasks, each task with an owner, an assignee and a due date, kept honest.",
  scenarios: [
    "A person sees their own account. Someone signed in asks who they are. Accepted when the answer is their account.",
    "A person makes a project. Someone signed in names a new project. Accepted when the project is made, and is theirs.",
    "A project with a blank name is refused. Accepted when it is refused, and says the name must not be blank.",
    "A task due in the past is refused. Someone creates a task due yesterday. Accepted when it is refused.",
    "A stranger cannot complete a task. Accepted when it is refused as forbidden.",
    "The assignee completes and reopens a task. Accepted when a task completed by its assignee can be reopened by them.",
  ],
  requirements: [
    "A person signs in with their email, and sees and changes their name and time zone.",
    "A person creates a task in a project, with a title, a due instant after now, an assignee and notes if they like, and owns it.",
    "A task's assignee or its owner completes it, and reopens it.",
    "A task's owner moves its due instant, never into the past.",
    "Anyone signed in lists the tasks.",
    "A person makes a project with a name that is not blank, which is theirs, and lists the projects.",
  ],
};

/* ---------- Mapping ---------- */
type Kind = "provided" | "own" | "build";
const kindName: Record<Kind, string> = { provided: "provided", own: "the product's own", build: "to build" };
const plan: { stage: string; items: { name: string; kind: Kind; concepts: string[]; paths: string; gates: string }[] }[] = [
  {
    stage: "S1 The application's own",
    items: [{ name: "Processes and the route table", kind: "build", concepts: ["config → belongs in spindle", "database → Rowtype_migrate_postgres"], paths: "server/app/ bin/server/", gates: "build verify layout" }],
  },
  {
    stage: "S2 Accounts",
    items: [
      { name: "Account: shape, table, statements", kind: "build", concepts: ["json-shape → Wiretype", "statement → Rowtype", "id → belongs in rowtype"], paths: "server/accounts/model/", gates: "build tests verify paths layout" },
      { name: "Signing in", kind: "provided", concepts: ["session → Spindle"], paths: "server/accounts/http/", gates: "build tests paths layout" },
      { name: "Account: routes", kind: "provided", concepts: ["route → Spindle"], paths: "server/accounts/http/", gates: "build tests verify paths layout" },
    ],
  },
  {
    stage: "S3 Tasks",
    items: [
      { name: "Project: shape, table, statements", kind: "build", concepts: ["json-shape → Wiretype", "statement → Rowtype"], paths: "server/projects/model/", gates: "build tests verify paths layout" },
      { name: "Task: shape, table, statements", kind: "build", concepts: ["json-shape → Wiretype", "statement → Rowtype", "migration → Rowtype_migrate"], paths: "server/tasks/model/", gates: "build tests verify paths layout" },
      { name: "Task states: open, done", kind: "own", concepts: ["task: open → done → open"], paths: "server/tasks/model/", gates: "build tests paths layout" },
      { name: "Rule: name not blank", kind: "own", concepts: ["the product's own"], paths: "server/projects/model/", gates: "build tests paths layout" },
      { name: "Rule: due after now", kind: "own", concepts: ["the product's own"], paths: "server/tasks/model/", gates: "build tests paths layout" },
      { name: "Who may see and do tasks", kind: "build", concepts: ["permission → belongs in spindle"], paths: "server/tasks/access/", gates: "build tests paths layout" },
      { name: "Project: routes", kind: "provided", concepts: ["route → Spindle"], paths: "server/projects/http/", gates: "build tests verify paths layout" },
      { name: "Task: routes", kind: "provided", concepts: ["route → Spindle", "Spindle.Path, Spindle.Route"], paths: "server/tasks/http/", gates: "build tests verify paths layout" },
    ],
  },
  {
    stage: "S4 The whole",
    items: [
      { name: "The API's document", kind: "provided", concepts: ["spec → Spindle"], paths: "api/", gates: "build fresh" },
      { name: "The scenarios", kind: "build", concepts: ["scenario → computed by HAF"], paths: "test/scenarios/", gates: "build tests" },
    ],
  },
];
const flat = plan.flatMap((s) => s.items);
const computed = 0.8;
const browse = 1.8;
const per = 1.1;
const cursorAt = (i: number) => browse + i * per;
const mapLoop = cursorAt(flat.length) + 1.4;
const kinds: { k: Kind; name: string }[] = [
  { k: "provided", name: "Provided" },
  { k: "own", name: "Own" },
  { k: "build", name: "To build" },
];
const count = (k: Kind) => flat.filter((x) => x.kind === k).length;

/* ---------- Scaffold ---------- */
/* Hypha Stack's scaffolds, the shapes an application takes; the task
   tracker, a server alone, takes hypha-api. */
const shapes = [
  { name: "hypha-api", parts: "a server", chosen: true },
  { name: "hypha-web", parts: "a front end" },
  { name: "hypha-fullstack", parts: "a server and its front end" },
];
const starts = [
  { what: "the route table, empty of its routes", at: 1.6 },
  { what: "Spindle's log", at: 2 },
  { what: "the API's document at /docs", at: 2.4 },
  { what: "/livez, /readyz, /metrics", at: 2.8 },
  { what: "make setup, build, test, lint, run", at: 3.2 },
];
const taken = 1;
const building = 3.8;
const built = 6.6;

/* ---------- Composition ---------- */
const gates = ["build", "tests", "lint", "verify", "paths", "layout"];
/* What each gate holds, how HAF runs it, and what it found, as the
   gates' docs say them. */
const held = ["the whole compiles", "every test, one of its work", "Hypha's rules, by litany", "statements on a fresh database", "only the paths it may touch", "the application's layout"];
const how = ["make build, in a container", "make test, in a container", "make lint, in a container", "make verify, in a container", "its change, read from git", "its change, read from git"];
const found = ["compiles, 4.1s", "16 passed, 2 new", "nothing found", "6 statements agree", "server/tasks/ only", "kept"];
const pieces = [
  { name: "Task: shape, table, statements", from: 0.6 },
  { name: "Task: routes", from: 2.8 },
  { name: "Task states: open, done", from: 5 },
  { name: "Rule: due after now", from: 7.2, refused: { gate: 1, again: 9.8 } },
];
const later = ["Rule: name not blank", "Who may see and do tasks", "Project: shape, table, statements", "Project: routes"];
const gap = 0.32;
const runs = pieces.map((p) => {
  const passFrom = p.refused ? p.refused.again + 0.5 : p.from + 0.3;
  const done = passFrom + gates.length * gap;
  return { ...p, passFrom, done };
});
const composeLoop = runs.at(-1)!.done + 3.6;
const rule = runs[3]!;
const refusedAt = rule.from + 0.3 + rule.refused!.gate * gap;
const again = rule.refused!.again;
const gateSeq = (g: number) => {
  const ev: string[] = ["0:wait"];
  for (const r of runs) {
    ev.push(`${f2(r.from)}:wait`);
    if (r.refused && g <= r.refused.gate) {
      const at = r.from + 0.3 + g * gap;
      ev.push(`${f2(at - gap)}:run`, `${f2(at)}:${g === r.refused.gate ? "fail" : "pass"}`);
    }
    if (r.refused) ev.push(`${f2(r.refused.again)}:wait`);
    ev.push(`${f2(r.passFrom + g * gap - gap)}:run`, `${f2(r.passFrom + g * gap)}:pass`);
  }
  return ev.join(" ");
};
const pieceSeq = (r: (typeof runs)[number]) => `0:wait ${f2(r.from)}:work ${r.refused ? `${f2(refusedAt)}:refused ${f2(r.refused.again)}:work ` : ""}${f2(r.done)}:done`;
const spark = "▂▃▅▆▅▃▂▁▂▄▆▇▆▄▃▂▃▅▇▆▄▂▁▂▃▄▆▅▃▂▁▂▃▅▆▇";

/* ---------- Validation ---------- */
const reqs: { fr: string; text: string; scenarios: string[] }[] = [
  { fr: "FR-1", text: "A person signs in with their email, and sees and changes their name and time zone.", scenarios: ["a person sees their own account", "a person renames their account"] },
  { fr: "FR-2", text: "A person creates a task in a project, with a title, a due instant after now, an assignee and notes if they like, and owns it.", scenarios: ["a task due in the past is refused"] },
  { fr: "FR-3", text: "A task's assignee or its owner completes it, and reopens it.", scenarios: ["a stranger cannot complete a task", "the assignee completes and reopens a task"] },
  { fr: "FR-4", text: "A task's owner moves its due instant, never into the past.", scenarios: ["the owner moves a task's due date"] },
  { fr: "FR-5", text: "Anyone signed in lists the tasks.", scenarios: ["the tasks are listed"] },
  { fr: "FR-6", text: "A person makes a project with a name that is not blank, which is theirs, and lists the projects.", scenarios: ["a person makes a project", "a project with a blank name is refused", "the projects are listed"] },
];
const proving = (() => {
  let t = 0.6;
  return reqs.map((r) => {
    const from = t;
    const sc = r.scenarios.map((s, k) => ({ s, at: from + 0.4 + k * 1.1, pass: from + 0.4 + (k + 1) * 1.1 - 0.15 }));
    const done = sc.at(-1)!.pass + 0.2;
    t = done + 0.5;
    return { ...r, from, sc, done, until: t };
  });
})();
const validLoop = proving.at(-1)!.until + 2.6;
const total = reqs.reduce((n, r) => n + r.scenarios.length, 0);
const passes = proving.flatMap((r) => r.sc.map((s) => s.pass)).sort((a, b) => a - b);
const passSeq = `0:0 ${passes.map((t, i) => `${f2(t)}:${i + 1}`).join(" ")}`;

/* ---------- Release ---------- */
const releasing = [
  { what: "Validated whole", note: "1635b79", at: 0.4, done: 1 },
  { what: "main fast-forwarded", note: "", at: 1, done: 1.8 },
  { what: "Tagged", note: "0.1.0", at: 1.8, done: 2.6 },
  { what: "Pushed", note: "origin", at: 2.6, done: 3.4 },
];
const released = 3.6;
const bench = 7.6;
const logs = ["migrated: 3 changes", "listening on :8080", "POST /projects 201 5ms", "POST /tasks 201 4ms", "GET /tasks 200 2ms", "POST /tasks/{id}:complete 200 3ms", "POST /tasks/{id}:reopen 200 3ms", "GET /tasks 200 2ms"];
const logAt = (i: number) => bench + 1.6 + i * 0.9;
const releaseLoop = logAt(logs.length) + 2.4;

/* HAF's top line and status bar, as its captures show them: the tabs
   of a scope's work with what is done ticked and what is at work
   playing, and the state over the keys that act on it. The Workbench
   has its own. */
const tabNames = ["Intent", "PRD", "Tasks", "Done"];
const tabAt: Record<string, number> = { Intent: 0, Mapping: 2, Scaffold: 2, Composition: 2, Validation: 2, Release: 3 };
const tabs = tabNames.map((name, i) => ({
  name,
  state: i < tabAt[step]! || (step === "Release" && i === 3) ? "done" : i === tabAt[step] ? "now" : "wait",
  on: i === tabAt[step],
}));
const status: Record<string, { state: string; spin?: boolean; keys: [string, string][] }> = {
  Intent: { state: "waiting", keys: [["↑↓", "choose"], ["enter", "answer"], ["o", "discuss"], ["→", "what is decided"], ["tab", "next"]] },
  working: { state: "working", spin: true, keys: [["P", "pause"], ["D", "stop"], ["a", "amend the PRD"], ["tab", "next"], ["esc", "acme"]] },
  Release: { state: "released", keys: [["↑↓", "move"], ["enter", "try it"], ["tab", "next"], ["esc", "acme"], ["?", "help"]] },
};
const now = status[step] ?? status.working!;
const benchBar = { state: "1 needs you", keys: [["↑↓", "move"], ["tab", "next"], ["esc", "HAF"], ["q", "quit"]] as [string, string][] };

const loop = ({ Intent: intentLoop, Mapping: mapLoop, Scaffold: built + 4, Composition: composeLoop, Validation: validLoop, Release: releaseLoop } as Record<string, number>)[step]!;
---

<figure class:list={["haf", `haf-${step.toLowerCase()}`]} data-loop={loop} aria-label={label}>
  <div class="screen" aria-hidden="true">
    <p class:list={["topline", step === "Release" && "one"]} data-at={step === "Release" ? 0 : undefined} data-until={step === "Release" ? bench : undefined}>
      <span class="badge">HAF</span><span class="scope">acme</span>
      {tabs.map((t) => <span class:list={["tab", t.on && "on"]}>{t.name}{t.state === "done" ? <span class="tick">✓</span> : t.state === "now" ? (step === "Intent" ? <span class="ask">?</span> : <span class="play">⏺</span>) : null}</span>)}
    </p>
    {step === "Release" && (
      <p class="topline one" data-at={bench}>
        <span class="badge">HAF</span><span class="scope">acme</span>
        <span class="tab">Scopes</span><span class="tab">Facts</span><span class="tab on">Workbench</span>
      </p>
    )}
    {
      step === "Intent" && (
        <div class="panes">
          <div class="pane main stack">
            <div class="lay scroll" data-at="0" data-until={drafted}>
              <div class="said">
                <p><span class="ok">✓</span>What would you like to build?</p>
                <p class="ans"><span class="dim">›</span>A team task tracker: tasks with a due date and an assignee, done or reopened, and an email reminder before a task is due.</p>
              </div>
              <p class="pad">Hi! I'll ask only what changes what gets built.</p>
              {asks.map((a) => (
                <>
                  <div class="ask flow" data-at={a.at} data-until={a.off}>
                    <p><span class="purple">?</span><span class="hi">{a.q}</span></p>
                    <p class="pad dim">{a.why}</p>
                    <ul class="opts">
                      {a.opts.map((o, k) => (
                        <li class="opt" {...seq(a.own ? (k === 0 ? `0:cur ${f2(a.at + 1.3)}:no` : k === a.opts.length - 1 ? `0:no ${f2(a.at + 1.3)}:cur` : "0:no") : k === 0 ? "0:cur" : "0:no")}>
                          {o}
                          {k === 0 && " (recommended)"}
                        </li>
                      ))}
                    </ul>
                    {a.own && (
                      <p class="typed flow" data-at={a.at + 1.7}>
                        <span class="dim">›</span>
                        <span data-type={`${f2(a.at + 1.8)} 1.8`}>{a.answer}</span>
                        <span class="cursor" />
                      </p>
                    )}
                  </div>
                  <div class="said flow" data-at={a.off}>
                    <p><span class="ok">✓</span>{a.q}</p>
                    <p class="ans"><span class="dim">›</span>{a.answer}</p>
                  </div>
                  {a.think && (
                    <div class="think flow" data-at={a.off + 0.2} data-until={a.thinkUntil}>
                      <p><span class="spin">⠋</span>Thinking, <span class="val" {...seq(`0:1s ${f2(a.off + 1.2)}:2s`)}>2s</span></p>
                      <p class="pad teal" data-type={`${f2(a.off + 0.3)} 1.8`}>{a.think}</p>
                    </div>
                  )}
                </>
              ))}
              <p class="flow" data-at={drafting}><span class="spin">⠋</span>Drafting the PRD</p>
            </div>
            <div class="lay col" data-at={drafted}>
              <p>
                <span class="hi">A team task tracker, API only</span>{" "}
                <span class="swap dim">
                  <span data-at="0" data-until={signed}>(v1, not signed)</span>
                  <span data-at={signed}>(v1, signed)</span>
                </span>
              </p>
              <div class="doc" data-roll={`${f2(reading)} ${f2(read - reading)}`}>
                <p class="hi gap">A team task tracker, API only</p>
                <p class="gap swap">
                  <span data-at="0" data-until={signed}>Status: Draft</span>
                  <span data-at={signed}>Status: Accepted</span>
                </p>
                <p class="hi gap">The problem</p>
                <p class="wrap">{prd.problem}</p>
                <p class="hi gap">User scenarios</p>
                {prd.scenarios.map((sc, i) => (
                  <p class="wrap num-item"><span class="dim">{i + 1}.</span>{sc}</p>
                ))}
                <p class="hi gap">Requirements</p>
                {prd.requirements.map((r, i) => (
                  <p class="wrap num-item"><span class="dim">FR-{i + 1}</span>{r}</p>
                ))}
              </div>
              <div class="swap">
                <div class="ask" data-at="0" data-until={signed}>
                  <p><span class="purple">?</span><span class="hi">Sign A team task tracker, API only?</span></p>
                  <p class="pad dim">Nothing is built until you sign it.</p>
                  <ul class="opts">
                    <li class="opt" data-state="cur">Yes, sign it</li>
                    <li class="opt" data-state="no">Change it, in your words</li>
                  </ul>
                </div>
                <div class="said" data-at={signed}>
                  <p><span class="ok">✓</span>Sign A team task tracker, API only?</p>
                  <p class="ans"><span class="dim">›</span>Yes, sign it</p>
                  <p class="gap"><span class="spin">⠋</span>Starting its work</p>
                </div>
              </div>
            </div>
          </div>
          <div class="pane side">
            <p class="hi">
              <span class="rec">⏺</span>
              <span class="swap">
                <span data-at="0" data-until={signed}>Intent</span>
                <span data-at={signed}>Mapping</span>
              </span>
            </p>
            <p class="segs">{segs(0, signed).map((s) => <span {...seq(s)} />)}</p>
            <p class="hi gap">Recap</p>
            <dl class="facts">
              <dt>Working on</dt>
              <dd class="swap">
                <span data-at="0" data-until={signed}>your request</span>
                <span data-at={signed}>the plan</span>
              </dd>
              <dt>Done</dt>
              <dd><span class="val" {...seq(`0:0 ${asks.map((a, i) => `${f2(a.off)}:${i + 1}`).join(" ")}`)}>{asks.length}</span> <span class="val" {...seq(`0:questions ${f2(asks[0]!.off)}:question ${f2(asks[1]!.off)}:questions`)}>questions</span> settled</dd>
              <dt>Next</dt>
              <dd class="swap">
                <span data-at="0" data-until={signed}>the PRD, drafted for you to sign</span>
                <span data-at={signed}>the build</span>
              </dd>
              <dt>Model</dt>
              <dd>claude-opus-5-5</dd>
            </dl>
            <p class="hi gap">Versions</p>
            <div class="swap">
              <p class="dim" data-at="0" data-until={drafting}>none yet</p>
              <p data-at={drafting} data-until={drafted}><span class="spin">⠋</span>v1  drafting</p>
              <p data-at={drafted} data-until={signed}><span class="purple">?</span>v1  to sign</p>
              <p data-at={signed}><span class="ok">✓</span>v1  signed</p>
            </div>
            <p class="meter gap">
              <span class="label">Spent</span>
              <span class="br">[</span>
              <span class="cells c-money">{bar([drafted]).map((at) => (at === undefined ? <span /> : <span data-at={at}>|</span>))}</span>
              <span class="num"><span class="val" {...seq(`0:$0.00 ${f2(asks[0]!.off)}:$0.01 ${f2(drafted)}:$0.02`)}>$0.02</span>/$100</span>
              <span class="br">]</span>
            </p>
          </div>
        </div>
      )
    }
    {
      step === "Mapping" && (
        <div class="panes">
          <div class="pane main col">
            <p><span class="hi">A team task tracker, API only</span> <span class="dim">(Mapping)</span></p>
            <p class="gap"><span class="hi">The plan</span> <span class="dim">({flat.length} items, {plan.length} stages)</span></p>
            <div class="scroll follow plan" data-at={computed}>
              {(() => {
                let n = 0;
                return plan.map((s) => (
                  <>
                    <p class="stage-name">{s.stage}</p>
                    {s.items.map((it) => {
                      const i = n++;
                      return (
                        <p class="row item" {...seq(`0:no ${f2(cursorAt(i))}:cur ${f2(cursorAt(i + 1))}:no`)}>
