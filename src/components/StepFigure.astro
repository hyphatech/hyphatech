<style>
  /* HAF's screen in its Garoa palette, its greys turned to Hypha's warm
     night so it sits on the page's ground: the main pane's ground, the side
     pane's, a key, a frame; its words, the bright, the dim, the faint;
     the gold of what is chosen, the orange of what is going on and of
     money, the green of what is done and proven, the teal of the model's
     work, the purple of a question, the red of a refusal. */
  .haf {
    --bg: #15120e;
    --pane: #1a150f;
    --key: #322b22;
    --frame: #3d362c;
    --bar: #262019;
    --fg: #d9d3c9;
    --hi: #f2f0ec;
    --dim: #948c83;
    --faint: #7b7369;
    --gold: #e7cb8a;
    --orange: #e3a068;
    --green: #9acaa2;
    --teal: #77babf;
    --purple: #af97d3;
    --red: #d87676;
    --fact: #56b19f;
    position: relative;
    height: 22rem;
    overflow: hidden;
    background: var(--bg);
  }
  @media (width >= 64rem) {
    .haf { height: 34rem; }
    .screen { font-size: 15px; }
  }
  .screen, .layer {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }
  .screen {
    font-family: "HAF Mono", var(--font-mono);
    font-size: 13px;
    line-height: 1.45;
    color: var(--fg);
    font-variant-ligatures: none;
    font-variant-numeric: tabular-nums;
  }
  .haf p, .haf li { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hi { color: var(--hi); font-weight: 600; }
  .dim { color: var(--dim); }
  .faint { color: var(--faint); }
  .mid { color: var(--dim); }
  .teal { color: var(--teal); }
  .fact { color: var(--fact); }
  .ok, .purple, .rec, .red, .arrow, .spin { display: inline-block; width: 2ch; }
  .spin { color: var(--orange); }
  .cur .spin { color: inherit; }
  .ok { color: var(--green); }
  .purple { color: var(--purple); }
  .rec { color: var(--orange); font-weight: 400; }
  .red { color: var(--red); }
  .gap { margin-top: 1.45em; }
  .pad { padding-left: 2ch; }
  .haf .wrap { white-space: normal; }
  .row { display: flex; justify-content: space-between; gap: 2ch; }
  .row > :first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .row > :last-child { flex: none; }

  /* The panes: the main one on the screen's ground, the side one on its
     own, as HAF splits them. */
  .panes { flex: 1; min-height: 0; display: flex; }
  /* The top line and the status bar: a line each on the bar's ground,
     keys as caps, as HAF draws them. The layers a step swaps between sit
     between them. */
  .topline, .statusbar { flex: none; display: flex; align-items: center; height: 1.45em; background: var(--bar); white-space: nowrap; overflow: hidden; }
  .screen > .layer { top: 1.45em; bottom: 1.45em; }
  .badge { padding: 0 1ch; background: var(--orange); color: var(--pane); font-weight: 600; }
  .topline .scope { padding: 0 1ch; background: var(--key); color: var(--hi); font-weight: 600; margin-right: 2ch; }
  .tab { margin-right: 3ch; color: var(--dim); }
  .tab.on { color: var(--hi); font-weight: 600; }
  .tab .tick { margin-left: 1ch; color: var(--green); font-weight: 400; }
  .tab .play { margin-left: 1ch; color: var(--orange); font-weight: 400; }
  .tab .ask { margin-left: 1ch; color: var(--purple); font-weight: 400; }
  .statusbar .state { padding: 0 3ch 0 1ch; color: var(--hi); font-weight: 600; }
  .statusbar .state .spin { width: 2ch; }
  .key { margin-right: 3ch; }
  .key kbd { font: inherit; padding: 0 1ch; margin-right: 1ch; background: var(--key); }
  .statusbar { margin-top: auto; }
  .statusbar .where { margin-left: auto; padding-right: 2ch; color: var(--faint); }
  .statusbar .scope { padding: 0 1ch; background: var(--key); color: var(--hi); font-weight: 600; }
  .statusbar .ver { padding: 0 1ch 0 2ch; color: var(--faint); }
  .pane { min-width: 0; min-height: 0; padding: 1rem 2ch; overflow: hidden; }
  .main { flex: 1; }
  .side { flex: 0 0 46%; background: var(--pane); }
  .col { display: flex; flex-direction: column; }
  @media (width < 40rem) {
    .side { display: none; }
  }

  /* What scrolls fills from its top, and keeps its last line in view. */
  .scroll { display: flex; flex-direction: column; gap: 1.45em; position: relative; overflow: hidden; }
  .scroll > * { flex-shrink: 0; }
  .plan.scroll, .logs.scroll { flex: 1; min-height: 0; gap: 0; }

  /* One place holding one state at a time. */
  .swap { display: inline-grid; }
  div.swap { display: grid; }
  .swap > * { grid-area: 1 / 1; }

  /* The six steps as segments, the one at work named over them. */
  .segs { display: flex; gap: 1ch; align-items: center; height: 1.45em; }
  .segs > span { flex: 1; height: 2px; background: var(--frame); }
  .segs > [data-state="done"] { background: var(--green); }
  .segs > [data-state="now"] { background: var(--orange); }

  /* The meters, as htop draws them: a label, the bar in brackets, the
     value inside at its right; each the pane's width, coloured by role. */
  .meters { display: flex; flex-direction: column; margin-top: 1.45em; }
  .meter { display: flex; align-items: center; }
  .meter .label { flex: none; width: 10ch; color: var(--dim); }
  .br { flex: none; color: var(--hi); font-weight: 600; }
  .cells { display: inline-flex; flex: 1; min-width: 0; overflow: hidden; }
  .cells > span { width: 1ch; flex: none; }
  .c-money { color: var(--orange); }
  .c-model { color: var(--teal); }
  .c-ok { color: var(--green); }
  .c-provided { color: var(--gold); }
  .c-own { color: var(--fg); }
  .c-build { color: var(--orange); }
  .meter .num { flex: none; margin-left: 1ch; color: var(--hi); font-weight: 600; }
  .spark { flex: 1; min-width: 0; overflow: hidden; color: var(--teal); }
  .spark-req { display: flex; justify-content: flex-end; flex: 1; min-width: 0; overflow: hidden; color: var(--green); }
  .facts .ok, .facts .faint { display: inline-block; width: 3ch; }
  .facts { display: grid; grid-template-columns: 11ch 1fr; }
  .facts dt { color: var(--faint); }
  .facts dd { min-width: 0; }
  .facts dd p { overflow: hidden; text-overflow: ellipsis; }

  /* Intent: the talk and its recap. */
  .haf-intent .main p { white-space: normal; }
  .ans, .think .teal { padding-left: 2ch; }
  .ans > .dim { display: inline-block; width: 2ch; margin-left: -2ch; }
  .ask { border: 1px solid var(--gold); border-radius: 6px; padding: 0.4rem 1ch; }
  .opts { margin-top: 0.725em; }
  .opt::before { content: "◇ "; color: var(--faint); }
  .opt[data-state="cur"] { background: var(--gold); color: var(--pane); }
  .opt[data-state="cur"]::before { content: "❯ "; color: inherit; }
  .typed { margin-top: 0.725em; }
  .typed > .dim { display: inline-block; width: 2ch; }
  .cursor { display: inline-block; width: 1ch; height: 1.2em; vertical-align: -0.25em; background: var(--fg); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* Mapping: the plan by stage, the item under the cursor, its lookup. */
  .plan { margin-top: 0.3em; }
  .stage-name { color: var(--hi); font-weight: 600; }
  .item { margin: 0 -1ch; padding: 0 1ch; }
  .item[data-state="cur"] { background: var(--gold); color: var(--pane); }
  .item[data-state="cur"] .kind { color: inherit; }
  .kind { color: var(--dim); }
  .k-provided { color: var(--gold); }
  .k-own { color: var(--fg); }
  .k-build { color: var(--orange); }

  /* Composition: the gates on the item at work, the items' states. */
  .cur { margin: 0 -1ch; padding: 0 1ch; background: var(--gold); color: var(--pane); }
  .cur .rec, .cur .arrow { color: inherit; }
  .gates { margin-top: 0.3em; }
  .gate { display: grid; grid-template-columns: 2ch 8ch minmax(0, 1fr); }
  .gname { color: var(--fg); }
  .gsay { min-width: 0; overflow: hidden; text-overflow: ellipsis; color: var(--faint); }
  .gsay > span { display: none; }
  .gate[data-state="wait"] .g-wait, .gate[data-state="run"] .g-run, .gate[data-state="pass"] .g-pass, .gate[data-state="fail"] .g-fail { display: inline; }
  .gate[data-state="wait"] .gname { color: var(--faint); }
  .gate[data-state="run"] .gsay { color: var(--dim); }
  .gate[data-state="pass"] .gsay { color: var(--fg); }
  .gate[data-state="fail"] .gsay { color: var(--red); }
  .piece { color: var(--faint); }
  .gate::before, .piece::before { content: ""; display: inline-block; width: 2ch; }
  .gate[data-state="run"]::before, .piece[data-state="work"]::before { content: var(--spin, "⠋"); color: var(--orange); }
  .gate[data-state="pass"]::before, .piece[data-state="done"]::before { content: "✓"; color: var(--green); }
  .gate[data-state="fail"] { color: var(--hi); }
  .gate[data-state="fail"]::before, .piece[data-state="refused"]::before { content: "✗"; color: var(--red); }
  .piece[data-state="work"], .piece[data-state="refused"] { color: var(--hi); }
  .piece[data-state="done"] { color: var(--fg); }

  /* Validation: the requirements, the one being proven chosen, its
     scenarios beside it. */
  .reqs { margin-top: 0.3em; }
  .req, .sc { display: flex; gap: 1ch; }
  .req { margin: 0 -1ch; padding: 0 1ch; color: var(--dim); }
  .mk { flex: none; width: 1ch; }
  .req .fr { flex: none; width: 4ch; color: var(--fg); }
  .req .txt, .sc .txt { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .req[data-state="wait"], .req[data-state="wait"] .fr { color: var(--faint); }
  .req[data-state="cur"], .req[data-state="curdone"], .req[data-state="cur"] .fr, .req[data-state="curdone"] .fr { background: var(--gold); color: var(--pane); }
  .req[data-state="cur"] .mk::before { content: var(--spin, "⠋"); }
  .req[data-state="curdone"] .mk::before, .req[data-state="done"] .mk::before, .sc[data-state="pass"] .mk::before { content: "✓"; }
  .req[data-state="done"] .mk::before, .sc[data-state="pass"] .mk::before { color: var(--green); }
  .sc[data-state="run"] .mk::before { content: var(--spin, "⠋"); color: var(--orange); }
  .sc[data-state="wait"] { color: var(--faint); }
  .detail { position: relative; }


  /* Intent: the talk, then the PRD over it, read and signed. */
  .stack { position: relative; }
  .lay { position: absolute; inset: 1rem 2ch; }
  .doc { flex: 1; min-height: 0; overflow: hidden; margin: 0.5em 0 0.9em; }
  .num-item { display: grid; grid-template-columns: 5ch 1fr; }
  .swap.mk2, .mk2 { display: inline-grid; width: 2ch; vertical-align: top; }
  .mk2 > * { grid-area: 1 / 1; width: 2ch; }

  /* A stepper's line: not begun faint, at work ⏺, done ✓. */
  .tick { color: var(--faint); }
  .tick::before { content: ""; display: inline-block; width: 2ch; flex: none; }
  .tick[data-state="run"] { color: var(--hi); }
  .tick[data-state="run"]::before { content: var(--spin, "⠋"); color: var(--orange); }
  .tick[data-state="pass"] { color: var(--fg); }
  .tick[data-state="pass"]::before { content: "✓"; color: var(--green); }
  .row.tick { gap: 0; }
  .row.tick > :first-child { flex: 1; }
  .req.done .mk::before { content: "✓"; color: var(--green); }
  .req.done .fr { color: var(--fg); }
  .detail { margin-top: 1.45em; flex: 1; min-height: 0; }
  .detail .one { position: absolute; inset: 0; }

  /* Release, then the Workbench. */
  .logs { margin-top: 0.3em; }
  .logs .faint { margin-right: 1ch; }

  /* The clock: what has not come yet waits unseen; what flows, a layer
     or a state takes no room until it comes. Without the clock, the
     markup stands at the loop's end. */
  .haf:not([data-run]) [data-until] { display: none; }
  .haf[data-run] [data-at]:not(.on) { opacity: 0; }
  .haf[data-run] .flow:not(.on), .haf[data-run] .layer:not(.on), .haf[data-run] .one:not(.on), .haf[data-run] .lay:not(.on) { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
  }
</style>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const turns = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏";

  for (const fig of document.querySelectorAll<HTMLElement>(".haf")) {
    const loop = Number(fig.dataset.loop);
    const marks = [...fig.querySelectorAll<HTMLElement>("[data-at]")].map((el) => ({
      el,
      at: Number(el.dataset.at),
      until: el.dataset.until === undefined ? Infinity : Number(el.dataset.until),
    }));
    const seqs = [...fig.querySelectorAll<HTMLElement>("[data-seq]")].map((el) => ({
      el,
      val: el.classList.contains("val"),
      steps: el.dataset.seq!.trim().split(/\s+/).map((s) => {
        const i = s.indexOf(":");
        return [Number(s.slice(0, i)), s.slice(i + 1)] as const;
      }),
    }));
    const types = [...fig.querySelectorAll<HTMLElement>("[data-type]")].map((el) => {
      const [a, d] = el.dataset.type!.split(" ").map(Number) as [number, number];
      return { el, a, d, text: el.textContent ?? "" };
    });
    const spins = fig.querySelectorAll<HTMLElement>(".spin");
    const sparks = [...fig.querySelectorAll<HTMLElement>(".spark")].map((el) => ({ el, text: [...(el.textContent ?? "")] }));
    const scrolls = [...fig.querySelectorAll<HTMLElement>(".scroll")];
    const rolls = [...fig.querySelectorAll<HTMLElement>("[data-roll]")].map((el) => {
      const [a, d] = el.dataset.roll!.split(" ").map(Number) as [number, number];
      return { el, a, d };
    });

    /* What scrolls keeps its last line in view; a list with a cursor
       keeps the cursor's line in view, as a terminal does. */
    const follow = () => {
      for (const el of scrolls) {
        const cur = el.classList.contains("follow") ? el.querySelector<HTMLElement>('[data-state="cur"]') : null;
        if (cur) {
          const lh = cur.offsetHeight;
          const want = cur.offsetTop + lh * 2 - el.clientHeight;
          el.scrollTop = Math.max(0, Math.ceil(want / lh) * lh);
        } else el.scrollTop = el.scrollHeight;
      }
    };

    /* Everything as it stands at second t of the loop. */
    const show = (t: number) => {
      for (const m of marks) m.el.classList.toggle("on", t >= m.at && t < m.until);
      for (const s of seqs) {
        let state = s.steps[0]![1];
        for (const [at, v] of s.steps) if (t >= at) state = v;
        if (s.el.dataset.state !== state) {
          s.el.dataset.state = state;
          if (s.val) s.el.textContent = state;
        }
      }
      for (const ty of types) {
        const n = Math.round(Math.min(1, Math.max(0, (t - ty.a) / ty.d)) * ty.text.length);
        if (ty.el.textContent!.length !== n) ty.el.textContent = ty.text.slice(0, n);
      }
      /* What a reader scrolls, a line at a time. */
      for (const r of rolls) {
        const lh = parseFloat(getComputedStyle(r.el).lineHeight);
        const k = Math.min(1, Math.max(0, (t - r.a) / r.d));
        r.el.scrollTop = Math.round((k * (r.el.scrollHeight - r.el.clientHeight)) / lh) * lh;
      }
      follow();
    };

    /* A terminal shows whole lines: what scrolls is cut to a whole
       number of them. */
    const whole = () => {
      for (const el of scrolls) {
        el.style.maxHeight = "";
        if (!el.clientHeight) continue;
        const lh = parseFloat(getComputedStyle(el).lineHeight);
        el.style.maxHeight = `${Math.floor(el.clientHeight / lh) * lh}px`;
      }
      follow();
    };
    new ResizeObserver(whole).observe(fig);
    if (still) continue;

    fig.dataset.run = "";
    let t = 0;
    show(t);
    let seen = false;
    let running = false;
    let last = 0;
    let rest = false;
    const tick = (ms: number) => {
      const dt = last ? Math.min(0.1, (ms - last) / 1000) : 0;
      last = ms;
      if (!seen) {
        running = false;
        return;
      }
      /* A step out of the run's view rests whole, and plays from its
         start once the run reaches it. */
      const resting = fig.closest("[data-dim]") !== null;
      if (resting) {
        if (!rest) show(loop - 0.001);
        rest = true;
      } else if (!document.hidden) {
        if (rest) t = 0;
        rest = false;
        t = (t + dt) % loop;
        show(t);
        const glyph = turns[Math.floor(ms / 80) % turns.length]!;
        for (const sp of spins) if (sp.textContent !== glyph) sp.textContent = glyph;
        fig.style.setProperty("--spin", `"${glyph}"`);
        const k = Math.floor(ms / 500);
        for (const s of sparks) {
          const at = k % s.text.length;
          const next = [...s.text.slice(at), ...s.text.slice(0, at)].join("");
          if (s.el.textContent !== next) s.el.textContent = next;
        }
      }
      requestAnimationFrame(tick);
    };
    new IntersectionObserver(([e]) => {
      seen = e!.isIntersecting;
      if (seen && !running) {
        running = true;
        last = 0;
        requestAnimationFrame(tick);
      }
    }).observe(fig);
  }
</script>
