---
/* A section heading, one line per entry, and its lede if given: a line
   of text, or paragraphs when the lede is long enough to need them.
   `mark` sets the last line in gold, as the kit sets a two-line
   heading's second line. */

interface Props {
  title: string | string[];
  id?: string;
  mark?: boolean;
}
const { title, id, mark = false } = Astro.props;
const lines = typeof title === "string" ? [title] : title;
const lede = Astro.slots.has("default") ? await Astro.slots.render("default") : undefined;
const paragraphs = lede?.trimStart().startsWith("<p");
---

<h2 id={id} class="t-h1 max-w-2xl">
  {lines.length === 1 ? lines[0] : lines.map((l, i) => <span class:list={["block", mark && i === lines.length - 1 && "text-accent"]}>{l}</span>)}
</h2>
{
  lede !== undefined &&
    (paragraphs ? (
      <div class="t-lede mt-8 max-w-2xl [&>p+p]:mt-4" set:html={lede} />
    ) : (
      <p class="t-lede mt-8 max-w-2xl" set:html={lede} />
    ))
}
