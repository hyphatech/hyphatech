---
import type { AstroComponent } from "@lucide/astro";

/* One set: Lucide, on one ladder, as the type has one: a glyph is 16px
   beside words (`sm`) or 20px heading a point or a card (`md`), and a
   badge holds the same two, 16 in its 36px circle (`k-badge`) and 20 in
   its 44px (`k-badge-lg`), only where a badge heads a column of its own.
   Nothing larger: a big icon cheapens what it stands for. The stroke is
   scaled by the size, so the LINE is 1.35px whichever is asked for: a
   set drawn at one stroke-width and rendered at two sizes has two
   weights in it. Icons beside words are `sm` and
   say nothing to a screen reader; the words do. `cap` follows the type
   it heads, its drawing as tall as the capitals; beside the slab's
   stems a 1.35px line reads as a hairline, so its line is 2.25px, held
   by a stroke the scaling leaves alone. */
interface Props {
  icon: AstroComponent;
  size?: "sm" | "md" | "cap";
  class?: string;
}

const ICON_PX = { sm: 16, md: 20 } as const;
const LINE_PX = 1.35;
const CAP_LINE_PX = 2.25;

const { icon: Drawn, size = "sm", class: className } = Astro.props;
---

{
  size === "cap" ? (
    <Drawn size={24} stroke-width={CAP_LINE_PX} aria-hidden="true" class:list={["size-[0.8em] shrink-0 [&_*]:[vector-effect:non-scaling-stroke]", className]} />
  ) : (
    <Drawn size={ICON_PX[size]} stroke-width={(LINE_PX * 24) / ICON_PX[size]} aria-hidden="true" class:list={["shrink-0", className]} />
  )
}
