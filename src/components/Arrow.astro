---
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Icon from "./Icon.astro";

/* Three glyphs, one meaning each, and no chevron: on through the site,
   back, or out of it. They stay still. */
interface Props {
  way: "on" | "back" | "out";
  class?: string;
}

const GLYPH = { on: ArrowRight, back: ArrowLeft, out: ArrowUpRight } as const;

const { way, class: className } = Astro.props;
---

<Icon icon={GLYPH[way]} class={className} />
