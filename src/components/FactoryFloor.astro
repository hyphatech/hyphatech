---
/* The levels as a factory floor, HAF being one: one line every board
   travels, the template router in the middle of it (`factory-model.ts`
   says what each level is on it). The SVG is drawn here at build time
   at the still; the script runs the line while the figure is on screen,
   cutting each order's template as it comes up. A level named in the
   same section, hovered or focused, edges its parts in gold. With
   reduced motion the line rests, and a named level still lights. */

import "./iso/iso.css";
import { CLOSE, factorySvg } from "./factory-geometry";
import { HEIGHT, Line, WIDTH } from "./factory-model";

interface Props {
  class?: string;
  /* What the figure frames: the whole floor; the jig alone, as the
     boundaries section shows it; or the floor the jig lands on, flying
     down from the boundaries section as the floor scrolls into place. */
  frame?: "whole" | "close" | "pull";
  id: string;
}
const { class: className, frame = "whole", id } = Astro.props;
const line = new Line();
let svg = factorySvg(
  line.lineAt(line.still()),
  (pass, points) => (pass < 0 ? [] : line.run(pass).path.slice(0, points)),
  (n) => line.order(n),
  () => 0,
  (pass) => line.markedBy(pass, line.still()),
  id,
  frame,
);
if (frame === "close") svg = svg.replace(`viewBox="0 0 ${WIDTH} ${HEIGHT}"`, `viewBox="${CLOSE.join(" ")}"`);
---

<figure
  class:list={["factory", className]}
  style={frame === "close" ? `width: ${((CLOSE[2] / WIDTH) * 100).toFixed(3)}%; margin-left: ${((CLOSE[0] / WIDTH) * 100).toFixed(3)}%` : undefined}
>
  <div class="iso route factory-art" data-factory={id} data-frame={frame} set:html={svg} />
</figure>

<script>
  import { IN_FEEDER, SINK, armSvg, boardMove, boardSolid, chunkD, chunksOf, cutFor, dropperSvg, faceOf, hatchSvg, insertsSvg, kitFor, leaving, lifted, marksSvg, nearSvg, passSvg, penSvg, placeOf, postsSvg, raised, seenFrom, sweepSvg, type Place } from "./factory-geometry";
  import { DROP_PARK, Line, MAG_Y, PEN_PARK, SLOTS, type Level } from "./factory-model";
  import { BOARD } from "./route-model";
  import { reducedMotion as still, whileVisible } from "../lib/motion";

  const start = performance.now();
  for (const root of document.querySelectorAll<HTMLElement>("[data-factory]")) {
    const one = (selector: string) => root.querySelector<SVGGElement>(selector)!;
    const id = root.dataset.factory!;
    const { pocketSvg } = kitFor(id);
    const line = new Line();
    const REST = line.still();
    const groups = { router: one('[data-move="router"]'), bushing: one('[data-move="bushing"]'), wrist: one('[data-move="wrist"]') };
    /* The jig alone has no line beyond its cell, and no bridges. */
    const maybe = (selector: string) => root.querySelector<SVGGElement>(selector);
    const layers = { posts: one("[data-posts]"), arm: one("[data-arm]"), far: one('[data-glow="far"]'), near: one('[data-glow="near"]'), pen: maybe("[data-pen]"), dropper: maybe("[data-dropper]") };
    /* The floor stands still until its jig has landed, and marks and
       sets inserts only from then on. */
    const pulls = root.dataset.frame === "pull";
    let onSince = pulls ? Infinity : -Infinity;
    const cuts = { template: one("[data-template]"), edge: one("[data-near]"), open: one("[data-open]"), bushing: one("[data-bushing]") };
    /* The template and its near edge, cut once per order. */
    const cutting = new Map<number, ReturnType<typeof cutFor>>();
    const cutOf = (n: number) => {
      if (!cutting.has(n)) cutting.set(n, cutFor(line.order(n)));
      for (const old of cutting.keys()) if (old < n - 2) cutting.delete(old);
      return cutting.get(n)!;
    };
    /* The boards' groups: ahead of the cell, in it, after it. */
    const rows: Record<Place, SVGGElement | null> = { head: maybe('[data-row="head"]'), cell: one('[data-row="cell"]'), end: maybe('[data-row="end"]') };
    const placed = (y: number): Place => {
      const place = placeOf(y);
      return rows[place] ? place : "cell";
    };
    const boards = SLOTS.map((_, n) => one(`[data-board="${n}"]`));
    /* What each board's pocket shows: whose pass, and how far cut. */
    const shown = boards.map(() => ({ pass: Number.NaN, points: 0 }));
    const written = new Map<Element, string>();
    const write = (element: Element, value: string, apply: () => void) => {
      if (written.get(element) === value) return;
      written.set(element, value);
      apply();
    };
    const html = (element: Element, value: string) => write(element, value, () => (element.innerHTML = value));
    const attribute = (element: Element, name: string, value: string) => write(element, `${name}=${value}`, () => element.setAttribute(name, value));

    /* A pocket grows by its last chunk: that one is redrawn, and any
       new ones are added after it. */
    const grow = (n: number, pass: number, points: number) => {
      const state = shown[n]!;
      const pocket = boards[n]!.querySelector("[data-pocket]")!;
      const path = pass < 0 ? [] : line.run(pass).path.slice(0, points);
      if (state.pass !== pass || points < state.points) {
        pocket.innerHTML = pocketSvg(n, path);
        shown[n] = { pass, points };
        return;
      }
      if (points === state.points) return;
      const cut = pocket.querySelector("[data-cut]")!;
      const passes = pocket.querySelector("[data-passes]")!;
      const chunks = chunksOf(path).map(chunkD);
      const from = Math.max(0, cut.children.length - 1);
      for (let i = from; i < chunks.length; i++) {
        if (i < cut.children.length) {
          cut.children[i]!.setAttribute("d", chunks[i]!);
          passes.children[i * 2]!.setAttribute("d", chunks[i]!);
          passes.children[i * 2 + 1]!.setAttribute("d", chunks[i]!);
        } else {
          cut.insertAdjacentHTML("beforeend", sweepSvg(chunks[i]!));
          passes.insertAdjacentHTML("beforeend", passSvg(chunks[i]!));
        }
      }
      state.points = points;
    };

    const draw = (time: number) => {
      const scene = line.lineAt(time);
      const cut = cutOf(scene.order);
      write(cuts.template, `order ${scene.order}`, () => {
        cuts.template.innerHTML = cut.template();
        cuts.edge.innerHTML = nearSvg(cut);
        cuts.open.setAttribute("d", cut.OPEN_PATH);
      });
      const on = time >= onSince;
      /* Lifted clear of the template, the bushing is no longer seen
         through its openings. */
      write(cuts.bushing, scene.lift > 8 ? "up" : "down", () => (scene.lift > 8 ? cuts.bushing.removeAttribute("clip-path") : cuts.bushing.setAttribute("clip-path", `url(#${id}-open)`)));
      attribute(groups.router, "transform", lifted(scene.bit, scene.lift));
      attribute(groups.bushing, "transform", lifted(scene.bit, scene.lift));
      attribute(groups.wrist, "transform", lifted(scene.arm, scene.lift));
      attribute(layers.posts, "transform", raised(scene.lift));
      attribute(layers.arm, "transform", raised(scene.lift));
      html(layers.posts, postsSvg(scene.bit, scene.arm));
      html(layers.arm, armSvg(scene.arm));
      html(layers.far, cut.glowSvg(scene.sample, "far"));
      html(layers.near, cut.glowSvg(scene.sample, "near"));
      if (layers.pen) html(layers.pen, penSvg(on ? scene.pen : { x: PEN_PARK[0], y: PEN_PARK[1], down: false }));
      if (layers.dropper) html(layers.dropper, dropperSvg(on ? scene.dropper : { x: DROP_PARK[0], y: DROP_PARK[1], falling: null }));
      const places = scene.boards.map((board) => placed(board.y));
      scene.boards.forEach((board, n) => {
        const element = boards[n]!;
        const place = places[n]!;
        attribute(element, "transform", boardMove(board.y, scene.dropped));
        /* With no line beyond the cell, a board past its feeder's far
           end is out of sight; at the run-out's end a finished board
           fades away. */
        attribute(element, "display", place === "cell" && board.y > IN_FEEDER ? "none" : "inline");
        attribute(element, "opacity", place === "end" ? leaving(board.y).toFixed(2) : "1");
        /* A blank let down from the magazine comes into sight. */
        if (place === "head" && board.y >= MAG_Y - 1 && shown[n]!.pass !== board.pass && ready && !still.matches) element.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 400, easing: "ease-out" });
        /* A board in or out of a box is seen only where it is out. */
        const from = seenFrom(board.y, place);
        const solid = element.querySelector("[data-solid]")!;
        write(solid, from > -BOARD.d / 2 ? from.toFixed(1) : "whole", () => {
          solid.innerHTML = boardSolid(from);
          element.querySelector("[data-face]")!.setAttribute("d", faceOf(from));
        });
        grow(n, board.pass, board.points);
        /* The layout the pen has drawn on it, until it is cut. */
        const marks = element.querySelector<SVGGElement>("[data-marks]")!;
        const drawn = root.dataset.frame === "close" || board.pass < 0 || board.points || !on ? [] : line.markedBy(board.pass, time);
        html(marks, drawn.length ? marksSvg(line.order(board.pass), drawn) : "");
        /* The inserts the bridge has dropped in it. */
        const inserts = element.querySelector<SVGGElement>("[data-inserts]")!;
        const set = root.dataset.frame === "close" || board.pass < 0 ? 0 : line.setBy(board.pass, time, onSince);
        if (inserts.dataset.set !== `${board.pass}:${set}`) {
          inserts.dataset.set = `${board.pass}:${set}`;
          inserts.innerHTML = set ? insertsSvg(line.order(board.pass), set) : "";
        }
      });
      /* Each board in its group, far boards first. */
      const order = scene.boards.map((board, n) => ({ y: board.y, n, place: places[n]! })).sort((a, b) => a.y - b.y);
      write(rows.cell!, order.map(({ n, place }) => `${place}${n}`).join(), () => order.forEach(({ n, place }) => rows[place]!.appendChild(boards[n]!)));
    };

    /* Every figure on the page reads one clock, so the jig above and the
       floor below show the same moment. */
    const now = () => REST + (performance.now() - start) / 1000;
    let clock = REST;
    let ready = false;
    const loop = whileVisible(
      root,
      () => {
        if (still.matches) return false;
        draw((clock = now()));
      },
      (visible) => {
        root.toggleAttribute("data-away", !visible);
        if (visible && !ready && !still.matches) {
          /* The drawing came from the same passes; read the pockets in. */
          ready = true;
          draw(clock);
        }
      },
    );
    still.addEventListener("change", () => {
      if (still.matches) draw((clock = REST));
      loop.play();
    });

    /* Landing, through a portal: as the jig the boundaries section shows
       scrolls off the screen, a hatch opens in the ground under it and
       its cell sinks through; as this floor comes up, the same hatch
       opens in the bay the floor keeps for it, the cell rises out of it,
       and it shuts round the cell's feet. The cell is the floor's own
       from then on: the floor turns on. Neither crosses anything between them. The
       two run on one clock, so they are the same machine at every frame.
       With reduced motion, each stays where it is and the floor runs. */
    const jig = root.dataset.frame === "pull" ? document.querySelector<HTMLElement>('[data-frame="close"]') : null;
    if (jig) {
      const svg = root.querySelector("svg")!;
      const away = jig.querySelector("svg")!;
      /* What passes through: the cell's parts, each in a carrier the
         portal's clip stays still on while the part moves. */
      const carried = (of: SVGSVGElement) => [...of.querySelectorAll<SVGGElement>("[data-carry]")];
      const coming = carried(svg);
      const going = carried(away);
      const portals = { coming: svg.querySelector<SVGGElement>("[data-portal]")!, going: away.querySelector<SVGGElement>("[data-portal]")! };
      const ease = (t: number) => (t <= 0 ? 0 : t >= 1 ? 1 : t * t * (3 - 2 * t));
      /* Through a portal, by how far along f: the hatch opens, then the
         cell passes through while it is wide open, then it shuts. */
      const through = (f: number) => ({ open: Math.max(0, Math.min(1, f / 0.15, (1 - f) / 0.15)), moved: Math.max(0, Math.min(1, (f - 0.15) / 0.7)) });
      const pass = (carriers: SVGGElement[], hatch: SVGGElement, of: string, f: number, way: "down" | "up") => {
        const { open, moved } = through(f);
        html(hatch, f > 0 && f < 1 ? hatchSvg(open) : "");
        const moving = moved > 0 && moved < 1;
        /* Down, the cell is gone once through; up, until it starts. */
        const gone = way === "down" ? moved >= 1 : moved <= 0 && f > 0;
        const by = (way === "down" ? moved : 1 - moved) * SINK;
        for (const carrier of carriers) {
          if (moving) carrier.setAttribute("clip-path", `url(#${of}-portal)`);
          else carrier.removeAttribute("clip-path");
          carrier.style.visibility = gone || (way === "up" && f <= 0) ? "hidden" : "";
          (carrier.firstElementChild as SVGGElement).style.transform = by && (moving || gone) ? `translate(0px, ${by.toFixed(1)}px)` : "";
        }
      };
      let queued = false;
      const place = () => {
        queued = false;
        /* The jig sinks as its frame goes off the top of the screen. */
        const from = away.getBoundingClientRect();
        const out = still.matches ? 0 : ease(-from.top / (from.height * 0.6));
        const p = still.matches ? 1 : ease((innerHeight * 0.85 - svg.getBoundingClientRect().top) / (innerHeight * 0.45));
        /* Landed, the cell is the floor's own and the floor turns on. */
        const landed = p >= 1;
        if (landed !== root.hasAttribute("data-landed")) onSince = landed ? now() : Infinity;
        root.toggleAttribute("data-landed", landed);
        pass(going, portals.going, "jig", out, "down");
        pass(coming, portals.coming, id, p, "up");
      };
      const queue = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(place);
      };
      addEventListener("scroll", queue, { passive: true });
      addEventListener("resize", queue);
      still.addEventListener("change", queue);
      place();
    }

    /* A level named in the same section lights while hovered or focused. */
    for (const name of root.closest("section")?.querySelectorAll<HTMLElement>("[data-level]") ?? []) {
      const on = () => root.setAttribute("data-on", name.dataset.level as Level);
      const off = () => root.removeAttribute("data-on");
      name.addEventListener("pointerenter", on);
      name.addEventListener("pointerleave", off);
      name.addEventListener("focusin", on);
      name.addEventListener("focusout", off);
    }
  }
</script>

<style is:global>
  /* The kit's tones in the site's night: warm greys a few steps off the
     ground, graphite for the machine, paper for the boards, gold for the
     opening. Each grey is graphite mixed into night, or paper into
     graphite, so it keeps graphite's warmth and moves with the palette.
     Only the halo, a shadow, is plain black. */
  .iso.route {
    --route-tone: var(--graphite-on-night);
    --anatomy-paper: var(--night);
    --anatomy-face: color-mix(in oklab, var(--route-tone) 15%, var(--night));
    --anatomy-top: color-mix(in oklab, var(--route-tone) 12%, var(--night));
    --anatomy-shade-0: color-mix(in oklab, var(--route-tone) 1%, var(--night));
    --anatomy-shade-1: color-mix(in oklab, var(--route-tone) 4%, var(--night));
    --anatomy-shade-2: color-mix(in oklab, var(--route-tone) 7%, var(--night));
    --anatomy-shade-3: color-mix(in oklab, var(--route-tone) 10%, var(--night));
    --anatomy-lit-top: color-mix(in oklab, var(--route-tone) 22%, var(--night));
    --anatomy-lit-shade: var(--anatomy-face);
    --anatomy-hi: color-mix(in oklab, var(--paper) 72%, var(--route-tone));
    --anatomy-mid: color-mix(in oklab, var(--route-tone) 93%, var(--night));
    --anatomy-lo: color-mix(in oklab, var(--route-tone) 53%, var(--night));
    --anatomy-faint: color-mix(in oklab, var(--route-tone) 30%, var(--night));
    --anatomy-lit: var(--paper);
    --anatomy-halo: #000;
    --anatomy-halo-opacity: 0.7;
    --anatomy-dot: var(--anatomy-hi);
    --anatomy-weight: 0.75px;
  }
  .iso.route .iso-line[data-tone="gold"] {
    stroke: var(--color-accent);
  }
  /* The sub-base is clear: its faces barely tint what lies under it. */
  .iso.route .route-glass > .iso-fill,
  .iso.route .route-glass > .iso-shade,
  .iso.route .route-glass > .iso-top {
    opacity: 0.32;
  }
  .iso.route .route-void {
    fill: color-mix(in oklab, #000 40%, var(--night));
    stroke: none;
  }
  /* A pocket: its walls in the deepest shade, its floor a step up, and
     the edge of each pass a thin ridge on it. */
  .iso.route .route-wall {
    fill: var(--anatomy-shade-0);
    stroke: none;
  }
  .iso.route .route-sweep {
    fill: none;
    stroke: #fff;
    stroke-width: 19;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .iso.route .route-pass,
  .iso.route .route-pass-edge {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .iso.route .route-pass-edge {
    stroke: var(--anatomy-shade-1);
    stroke-width: 19;
  }
  .iso.route .route-pass {
    stroke: var(--anatomy-shade-3);
    stroke-width: 17.6;
  }
  .iso.route .route-glow {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 3px;
    stroke-linecap: round;
  }
  .iso.route .route-post {
    stroke-width: 1.6px;
  }
  /* The boxes' lamps breathe; they say the boxes are at work, not how. */
  .iso.route .route-lamp circle {
    animation: route-lamp 2.4s ease-in-out infinite;
  }
  .iso.route[data-away] .route-lamp circle {
    animation-play-state: paused;
  }
  @keyframes route-lamp {
    50% {
      opacity: 0.25;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .iso.route .route-lamp circle {
      animation: none;
    }
  }
  /* A portal's opening: a step darker than the ground, not a hole. */
  .iso.factory-art .iso-hatch {
    fill: color-mix(in oklab, #000 22%, var(--night));
    stroke: none;
  }
  /* The line beyond the cell waits for it to land. */
  .iso.factory-art[data-frame="pull"]:not([data-landed]) :is([data-row="head"], [data-row="end"]) {
    visibility: hidden;
  }
  /* The level named is edged in gold and the others fade back. */
  .iso.factory-art [data-layer] {
    transition: opacity 300ms var(--ease-state, ease);
  }
  .iso.factory-art [data-layer] .iso-edge {
    transition: stroke 300ms var(--ease-state, ease);
  }
  .iso.factory-art[data-on="language"] [data-layer]:not([data-layer="language"]),
  .iso.factory-art[data-on="stack"] [data-layer]:not([data-layer="stack"]),
  .iso.factory-art[data-on="ontology"] [data-layer]:not([data-layer="ontology"]),
  .iso.factory-art[data-on="factory"] [data-layer]:not([data-layer="factory"]) {
    opacity: 0.35;
  }
  .iso.factory-art[data-on="language"] [data-layer="language"] .iso-edge,
  .iso.factory-art[data-on="stack"] [data-layer="stack"] .iso-edge,
  .iso.factory-art[data-on="ontology"] [data-layer="ontology"] .iso-edge,
  .iso.factory-art[data-on="factory"] [data-layer="factory"] .iso-edge {
    stroke: var(--color-accent);
  }
</style>
