---
/* Sand on a square Chladni plate: order from explicit constraints. A
   metaphor, never a diagram; nothing on it is labelled.

   A plate in a mode shakes its grains where it moves; they wander until
   they rest on its nodal lines. The simulation does only that.

   Sand under the words is kept faint. Without JavaScript the band is its
   ground; with reduced motion one settled frame is held. */
---

<div class="chladni pointer-events-none absolute inset-0 overflow-hidden" data-chladni aria-hidden="true">
  <canvas class="absolute top-0 left-0"></canvas>
</div>

<style>
  .chladni canvas {
    opacity: 0;
    transition: opacity 500ms var(--ease-glide);
  }
  .chladni.is-live canvas {
    opacity: 1;
  }
</style>

<script>
  import { Sand, stage, tone, type Scene } from "../scripts/stage";

  /* Modes in play order: [n, m, sign], n and m half-waves across the
     plate, the two standing waves added (1) or cancelled (-1). Both odd
     or both even, so each figure is centre-symmetric. Kept low so a
     figure never becomes a lattice on a large band. */
  const MODES: [number, number, 1 | -1][] = [
    [0, 2, -1],
    [2, 4, 1],
    [3, 5, 1],
    [2, 6, 1],
    [4, 6, 1],
    [4, 8, 1],
    [6, 8, 1],
    [7, 9, 1],
  ];

  /* Seconds each mode is held, and over which the shaking eases from
     full to SHIMMER, its resting share. */
  const HOLD = 9;
  const EASE = 3.2;
  const SHIMMER = 0.18;
  /* Per frame, as a share of the plate: the farthest throw where the
     plate moves most, and the pull down the slope toward stillness. */
  const THROW = 0.009;
  const SLIDE = 0.0018;
  /* Grains per square CSS pixel, clamped to FEWEST..MOST; one grain's
     alpha, and the curve (below 1) that lifts a lone grain. */
  const DENSITY = 0.032;
  const FEWEST = 12000;
  const MOST = 70000;
  const GRAIN = 0.2;
  const CURVE = 0.85;

  /* Throw for the plate's motion, 0 to 2 in LEVELS steps, tabled for
     speed. The easing narrows the still areas where nodal lines cross,
     so sand does not pile up there. */
  const LEVELS = 1024;
  const EASED = new Float32Array(LEVELS + 1);
  for (let k = 0; k <= LEVELS; k++) EASED[k] = Math.min(1, (2 * k) / LEVELS / 2) ** 0.35;

  /* Each standing wave is a product of one wave per axis, so cos and sin
     are tabled per pixel along each axis on resize, not computed eight
     times a grain a frame. */
  type Pair = [cos: Float32Array, sin: Float32Array];
  type Waves = { a: number; c: number; sign: 1 | -1; ax: Pair; cx: Pair; ay: Pair; cy: Pair };

  function chladni(sand: Sand): Scene {
    let width = 0;
    let height = 0;
    /* A square plate as wide as the band's longer side, centred. */
    let side = 1;
    let offsetX = 0;
    let offsetY = 0;
    let grains = 0;
    let x = new Float32Array(0);
    let y = new Float32Array(0);
    let time = 0;
    let waves: Waves[] = [];

    /* Cos and sin along an axis of a wave turning `k` radians per plate
       side, sampled at each pixel's middle; the plate starts at `from`. */
    const along = (length: number, from: number, k: number): Pair => {
      const cos = new Float32Array(length + 1);
      const sin = new Float32Array(length + 1);
      for (let i = 0; i <= length; i++) {
        const p = (k * (i + 0.5 - from)) / side;
        cos[i] = Math.cos(p);
        sin[i] = Math.sin(p);
      }
      return [cos, sin];
    };

    return {
      warm: 0,
      rest: HOLD * 0.8,
      sand,
      resize(w, h) {
        width = w;
        height = h;
        side = Math.max(w, h);
        offsetX = (w - side) / 2;
        offsetY = (h - side) / 2;
        waves = MODES.map(([n, m, sign]) => {
          const a = n * Math.PI;
          const c = m * Math.PI;
          return { a, c, sign, ax: along(w, offsetX, a), cx: along(w, offsetX, c), ay: along(h, offsetY, a), cy: along(h, offsetY, c) };
        });
        grains = Math.round(Math.min(MOST, Math.max(FEWEST, w * h * DENSITY)));
        x = new Float32Array(grains);
        y = new Float32Array(grains);
        for (let i = 0; i < grains; i++) {
          x[i] = Math.random() * width;
          y[i] = Math.random() * height;
        }
        time = 0;
      },
      /* A grain is thrown as hard as the plate moves under it and slides
         toward stillness; on a nodal line it rests. */
      step(dt) {
        time += dt;
        const index = Math.floor(time / HOLD);
        const { a, c, sign, ax, cx, ay, cy } = waves[index % waves.length]!;
        const [cax, sax] = ax;
        const [ccx, scx] = cx;
        const [cay, say] = ay;
        const [ccy, scy] = cy;
        const into = time - index * HOLD;
        const strength = SHIMMER + (1 - SHIMMER) * Math.exp(-into / (EASE / 3));
        const frames = dt * 60;
        const throwBy = THROW * side * strength * frames;
        const slide = SLIDE * side * frames * 0.05;
        for (let i = 0; i < grains; i++) {
          const ix = x[i]! | 0;
          const iy = y[i]! | 0;
          const f = cax[ix]! * ccy[iy]! + sign * ccx[ix]! * cay[iy]!;
          const fx = -a * sax[ix]! * ccy[iy]! - sign * c * scx[ix]! * cay[iy]!;
          const fy = -c * cax[ix]! * scy[iy]! - sign * a * ccx[ix]! * say[iy]!;
          const swing = f < 0 ? -f : f;
          const move = EASED[swing >= 2 ? LEVELS : (swing * (LEVELS / 2)) | 0]!;
          let qx = x[i]! + (Math.random() - 0.5) * 2 * throwBy * move - slide * f * fx;
          let qy = y[i]! + (Math.random() - 0.5) * 2 * throwBy * move - slide * f * fy;
          if (qx < 0) qx = -qx;
          else if (qx >= width) qx = 2 * width - qx - 1;
          if (qy < 0) qy = -qy;
          else if (qy >= height) qy = 2 * height - qy - 1;
          x[i] = qx;
          y[i] = qy;
        }
      },
      draw(context) {
        sand.clear();
        for (let i = 0; i < grains; i++) sand.plot(x[i]!, y[i]!);
        sand.put(context);
      },
    };
  }

  for (const host of document.querySelectorAll<HTMLElement>("[data-chladni]")) {
    const sand = new Sand(tone("--color-ink"), GRAIN, CURVE);
    stage(host, chladni(sand), { underWords: 0.08, feather: 28, head: 90, foot: 160 });
  }
</script>
