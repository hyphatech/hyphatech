---
/* The levels as a die set, from the ground up (`dieset-model.ts` says
   what it is). The SVG is drawn here at build time with the ram on its
   way down; the script runs the press while the figure is on screen. A
   level named in the same section, hovered or focused, lifts in the
   drawing with everything that stands on it, its outlines in gold. With
   reduced motion the press rests, and a named level still lights. */

import "./iso/iso.css";
import { dieSetSvg } from "./dieset-geometry";
import { REST, pressAt } from "./dieset-model";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const rest = { language: 0, stack: 0, ontology: 0, factory: 0 };
---

<figure class:list={["dieset", className]}>
  <div class="iso dieset-art" data-dieset set:html={dieSetSvg(rest, pressAt(REST))} />
</figure>

<script>
  import { blankSvg, lift, pillarsSvg, punchClip, punchesHighSvg, punchesLowSvg, standing, type Lifts } from "./dieset-geometry";
  import { LEVELS, LIFT, REST, STATIONS, pressAt, type Level } from "./dieset-model";
  import { reducedMotion as still, whileVisible } from "../lib/motion";

  for (const root of document.querySelectorAll<HTMLElement>("[data-dieset]")) {
    const one = (selector: string) => root.querySelector<SVGGElement>(selector)!;
    const lifted = Object.fromEntries(LEVELS.map((level) => [level, one(`[data-lift="${level}"]`)])) as Record<Level, SVGGElement>;
    const runs = Object.fromEntries(["low-back", "low-front", "mid-back", "mid-front", "top", "punch-low", "punch-high"].map((run) => [run, one(`[data-run="${run}"]`)]));
    const blank = one("[data-blank]");
    const clips = STATIONS.map((_, i) => root.querySelector<SVGPathElement>(`[data-punch-clip="${i}"]`)!);

    /* Each level eases toward its lift; the one named lifts, and carries
       everything above it. */
    const lifts: Lifts = { language: 0, stack: 0, ontology: 0, factory: 0 };
    let named: Level | null = null;
    let clock = REST;

    const written = new Map<Element, string>();
    const set = (element: Element, value: string, apply: () => void) => {
      if (written.get(element) === value) return;
      written.set(element, value);
      apply();
    };
    const html = (element: Element, value: string) => set(element, value, () => (element.innerHTML = value));

    const draw = () => {
      const press = pressAt(clock);
      const z = standing(lifts, press.down);
      for (const level of LEVELS) set(lifted[level], z[level].toFixed(2), () => lifted[level].setAttribute("transform", lift(z[level])));
      html(runs["low-back"]!, pillarsSvg(z, "low", "back"));
      html(runs["low-front"]!, pillarsSvg(z, "low", "front"));
      html(runs["mid-back"]!, pillarsSvg(z, "mid", "back"));
      html(runs["mid-front"]!, pillarsSvg(z, "mid", "front"));
      html(runs["top"]!, pillarsSvg(z, "top", "all"));
      html(runs["punch-low"]!, punchesLowSvg(z));
      html(runs["punch-high"]!, punchesHighSvg(z));
      clips.forEach((clip, i) => set(clip, `${z.ontology.toFixed(2)}:${z.factory.toFixed(2)}`, () => clip.setAttribute("d", punchClip(i, z))));
      html(blank, blankSvg(press, z));
    };

    const loop = whileVisible(
      root,
      (seconds) => {
        let moving = false;
        for (const level of LEVELS) {
          const target = named === level ? LIFT : 0;
          const next = lifts[level] + (target - lifts[level]) * (1 - Math.exp(-seconds / 0.12));
          lifts[level] = Math.abs(target - next) < 0.05 ? target : next;
          if (lifts[level] !== target) moving = true;
        }
        if (!still.matches) clock += seconds;
        draw();
        return !still.matches || moving;
      },
      (visible) => root.toggleAttribute("data-away", !visible),
    );
    still.addEventListener("change", () => {
      if (still.matches) clock = REST;
      loop.play();
    });

    /* A level named in the same section lifts and lights while hovered or
       focused. */
    for (const name of root.closest("section")?.querySelectorAll<HTMLElement>("[data-level]") ?? []) {
      const on = () => {
        named = name.dataset.level as Level;
        root.setAttribute("data-on", named);
        loop.play();
      };
      const off = () => {
        named = null;
        root.removeAttribute("data-on");
        loop.play();
      };
      name.addEventListener("pointerenter", on);
      name.addEventListener("pointerleave", off);
      name.addEventListener("focusin", on);
      name.addEventListener("focusout", off);
    }
  }
</script>

<style is:global>
  /* The router's tones, so the figures on the page are one set: graphite
     on night for the steel, paper for what is hardened and what is
     made, gold for the guide plate's openings. */
  .iso.dieset-art {
    --ds-tone: var(--graphite-on-night);
    --anatomy-paper: var(--night);
    --anatomy-face: color-mix(in oklab, var(--ds-tone) 15%, var(--night));
    --anatomy-top: color-mix(in oklab, var(--ds-tone) 12%, var(--night));
    --anatomy-shade-0: color-mix(in oklab, var(--ds-tone) 1%, var(--night));
    --anatomy-shade-1: color-mix(in oklab, var(--ds-tone) 4%, var(--night));
    --anatomy-shade-2: color-mix(in oklab, var(--ds-tone) 7%, var(--night));
    --anatomy-shade-3: color-mix(in oklab, var(--ds-tone) 10%, var(--night));
    --anatomy-lit-top: color-mix(in oklab, var(--ds-tone) 22%, var(--night));
    --anatomy-lit-shade: var(--anatomy-face);
    --anatomy-hi: color-mix(in oklab, var(--paper) 72%, var(--ds-tone));
    --anatomy-mid: color-mix(in oklab, var(--ds-tone) 93%, var(--night));
    --anatomy-lo: color-mix(in oklab, var(--ds-tone) 53%, var(--night));
    --anatomy-faint: color-mix(in oklab, var(--ds-tone) 30%, var(--night));
    --anatomy-lit: var(--paper);
    --anatomy-halo: #000;
    --anatomy-halo-opacity: 0.7;
    --anatomy-dot: var(--anatomy-hi);
    --anatomy-weight: 0.75px;
  }
  .iso.dieset-art .iso-line[data-tone="gold"] {
    stroke: var(--color-accent);
  }
  .iso.dieset-art .ds-void {
    fill: color-mix(in oklab, #000 45%, var(--night));
    stroke: none;
  }
  .iso.dieset-art [data-layer] .iso-edge {
    transition: stroke 300ms var(--ease-state, ease);
  }
  .iso.dieset-art[data-on="language"] [data-layer="language"] .iso-edge,
  .iso.dieset-art[data-on="stack"] [data-layer="stack"] .iso-edge,
  .iso.dieset-art[data-on="ontology"] [data-layer="ontology"] .iso-edge,
  .iso.dieset-art[data-on="factory"] [data-layer="factory"] .iso-edge {
    stroke: var(--color-accent);
  }
</style>
