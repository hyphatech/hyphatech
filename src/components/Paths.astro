---
/* The ways in that end the landing and Hypha Stack. The first panel is on
   paper, as the one to try first; the others lie on the halftone, its
   dots growing toward their actions. Actions align at the panels' foot;
   titles stay on one line on a laptop. */

import type { AstroComponent } from "@lucide/astro";
import Icon from "./Icon.astro";

export interface Path {
  title: string;
  body: string;
  href: string;
  action: string;
  icon: AstroComponent;
  primary: boolean;
  extra?: { label: string; href: string };
}

interface Props {
  paths: Path[];
}

const { paths } = Astro.props;
---

<ul class="mt-12 grid gap-4 md:grid-cols-3">
  {
    paths.map((s) => (
      <li class:list={["relative isolate flex flex-col overflow-hidden rounded-panel p-6 md:p-8 [&>*:not(.k-halftone)]:relative", "border", s.primary ? "theme-light border-transparent" : "border-rule"]}>
        {!s.primary && <div class="k-halftone" aria-hidden="true"></div>}
        <h3 class="t-h2">{s.title}</h3>
        <p class="mt-3 grow text-graphite">{s.body}</p>
        <div class="mt-6 flex flex-wrap items-center md:mt-8 gap-x-5 gap-y-3">
          <a href={s.href} class={s.primary ? "btn-primary" : "btn"}>
            <Icon icon={s.icon} />
            {s.action}
          </a>
          {s.extra && (
            <a href={s.extra.href} class="t-control tap underline decoration-current/40 underline-offset-4 hover:decoration-current">
              {s.extra.label}
            </a>
          )}
        </div>
      </li>
    ))
  }
</ul>
