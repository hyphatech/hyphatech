---
/* The Factory's design, as the decisions it is built on: a card each,
   its top an isometric diagram of the decision (decisions-geometry.ts)
   -- tiles over a gridded base, each with its icon laid on its top,
   dashed links and gold on the tile the decision lands on, with no
   label or pill: the icons and the drawing say it -- and the decision
   under it, what it is
   and what it gives you. Never rows. Every drawing is what hypha-haf's
   docs say (server.md, journal.md, tools.md, gates.md, build.md,
   models.md, vaults.md, connectors.md). On a phone the cards stack. */

import Board from "./Board.astro";
import type { Scene } from "./decisions-geometry";
import "./iso/lit.css";


/* Links run on the base, along its grid lines: `on` lifts a path of
   plan points to just over it. */
const on = (...points: [number, number][]) => points.map(([x, y]) => [x, y, 0.5] as [number, number, number]);
const line = (...points: [number, number][]) => { const p = on(...points); return { from: p[0]!, via: p.slice(1, -1), to: p[p.length - 1]! }; };

const cards: { title: string; body: string; scene: Scene }[] = [
  {
    title: "A harness built for autonomy",
    body: "A borrowed agent brings its own tools and its own idea of done. Here every tool keeps to the paths the plan gave each piece, and only the gates decide when the work is done.",
    /* The loop that runs itself: HAF gives the model its piece, the
       work meets the gates, a refusal goes back round the back of the
       board, and a pass goes on to done; only the verdicts are named. */
    scene: {
      tiles: [
        { at: [-32, 32, 3], icon: "factory", gold: true },
        { at: [-32, -32, 3], icon: "sparkles" },
        { at: [32, -32, 3], icon: "gates" },
        { at: [32, 32, 3], icon: "check" },
      ],
      links: [
        line([-32, 18], [-32, -18]),
        line([-18, -32], [18, -32]),
        line([32, -46], [32, -56], [-32, -56], [-32, -46]),
        { ...line([32, -18], [32, 18]), gold: true, solid: true },
      ],
    },
  },
  {
    title: "Isolated by default",
    body: "No permission prompts to answer. Everything a model runs stays inside a Podman container, away from your secrets and your machine.",
    /* Every way out of a model's commands ends at the red plate's edge. */
    scene: {
      bound: { x: -24, y: -24, w: 48, d: 48 },
      tiles: [
        { at: [0, 0, 3], icon: "terminal", gold: true },
        { at: [48, 0, 3], icon: "globe" },
        { at: [0, 48, 3], icon: "key" },
      ],
      links: [line([14, 0], [24, 0]), line([0, 14], [0, 24])],
    },
  },
  {
    title: "Never a black box",
    body: "Your team hears about the work in the tools it already uses: a message when a person is needed, a report when a change lands, and a pull request to read it the familiar way, with nothing to approve.",
    /* HAF at the back, the work reaching down to the team's tools. */
    scene: {
      tiles: [
        { at: [0, -32, 3], icon: "factory", gold: true },
        { at: [-32, 32, 3], icon: "github" },
        { at: [0, 32, 3], icon: "slack" },
        { at: [32, 32, 3], icon: "mail" },
      ],
      links: [
        line([0, -18], [0, 18]),
        line([0, 0], [-32, 0], [-32, 18]),
        line([0, 0], [32, 0], [32, 18]),
      ],
    },
  },
];

/* The whole factory on one board, every part the decisions draw alone
   assembled round HAF: the model and the gates behind, a model's
   commands on their red plate, your repositories and your team's tools
   in front. Drawn alone, with no words, when `whole` is set. */
const whole: Scene = {
  bound: { x: -62, y: 34, w: 28, d: 28 },
  tiles: [
    { at: [0, 0, 3], icon: "factory", gold: true },
    { at: [-48, -48, 3], icon: "sparkles" },
    { at: [48, -48, 3], icon: "gates" },
    { at: [-48, 0, 3], icon: "mail" },
    { at: [48, 0, 3], icon: "slack" },
    { at: [-48, 48, 3], icon: "terminal", size: 20 },
    { at: [0, 48, 3], icon: "github" },
  ],
  links: [
    line([-14, 0], [-34, 0]),
    line([14, 0], [34, 0]),
    line([0, 14], [0, 34]),
    line([0, -14], [0, -48], [-34, -48]),
    line([0, -48], [34, -48]),
    line([-8, 14], [-8, 24], [-48, 24], [-48, 33]),
  ],
};

interface Props {
  whole?: boolean;
}
const list = Astro.props.whole ? [{ title: "", body: "", scene: whole }] : cards;

---

<ul class:list={["decisions lit-night", { whole: Astro.props.whole }]}>
  {
    list.map((c, i) => {
      const n = Astro.props.whole ? 100 + i : i;
      return (
        <li class:list={["decision", { flip: Math.floor(i / 2) % 2 === 1, right: i % 2 === 1 }]} style={`--row:${Math.floor(i / 2) + 1};--one:${i + 1}`}>
          <span class="mark" aria-hidden="true"></span>
          <div class="stage" aria-hidden="true">
            <Board scene={c.scene} n={n} />
          </div>
          {c.title && (
            <div class="words">
              <h3 class="t-h2">{c.title}</h3>
              <p class="t-lede max-md:text-base/6">{c.body}</p>
            </div>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  /* A chess grid on the section's own ground, no frame and no cells,
     one rule across between decisions: each decision a drawing cell
     and a words cell, two decisions a row, every other row starting
     with its words, so drawings and words alternate both ways. One
     decision a row on a tablet, alternating; on a phone, the drawing
     over its words. No cell is filled. */
  /* On a phone each decision stands its drawing over its words, ruled
     from the next by the same hairline the chessboard draws, so a
     drawing is never read with the words of the decision under it. */
  /* Each decision opens on a mark: a hairline fading out at both ends,
     a small gold registration cross at its middle, as the plate's
     corners are marked. The first opens on one too, so the set stands
     apart from the opener; the section's edge closes it. */
  .decisions { display: grid; }
  .decision:last-child .words { padding-bottom: 0; }
  .mark {
    display: block; position: relative; height: 1px; grid-column: 1 / -1;
    background: linear-gradient(90deg, transparent, var(--color-rule) 20%, var(--color-rule) 80%, transparent);
  }
  .mark::before, .mark::after {
    content: ""; position: absolute; left: 50%; top: 50%; background: var(--accent-on-night);
    transform: translate(-50%, -50%);
  }
  .mark::before { width: 12px; height: 1.5px; }
  .mark::after { width: 1.5px; height: 12px; }
  .stage { padding: 2rem 0.75rem 0.25rem; display: grid; place-items: center; }
  .words { padding: 0.5rem 0.25rem 2rem; display: flex; flex-direction: column; justify-content: center; }
  /* From a tablet up: a decision a row, a large drawing beside its
     words, the drawing on alternate sides, so the frame reads as a
     chessboard of drawings and words. */
  @media (width >= 48rem) {
    .decisions { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 0; column-gap: 0; }
    .mark { grid-row: calc(var(--one) * 2 - 1); }
    .decision { display: contents; }
    .stage, .words { padding-block: 2.5rem; }
    /* The last decision ends on the section's own padding. */
    .decision:last-child .stage, .decision:last-child .words { padding-bottom: 0; }
    .stage, .words { grid-row: calc(var(--one) * 2); }
    .stage { grid-column: 1; padding-inline: 0; } .words { grid-column: 2; padding-inline: 0; }
    /* Flush with the page's content edges; the gutter between the halves
       sits in the middle. */
    .decision:not(.right) .stage, .right .words { padding-right: 2.5rem; }
    .decision:not(.right) .words, .right .stage { padding-left: 2.5rem; }
    .right .stage { grid-column: 2; } .right .words { grid-column: 1; }
    .decision .words { margin-top: 0; }
    .stage :global(svg) { max-width: 30rem; margin-inline: auto; }
    .decision .words p { max-width: 28rem; }
  }
  /* The whole factory: one board, no mark, no chessboard. */
  .decisions.whole { display: block; }
  .whole .decision { display: block; }
  .whole .mark { display: none; }
  .whole .stage { padding: 0; border: 0; }
  .whole .stage :global(svg) { max-width: none; }


  .words { margin-top: 0.25rem; }
  /* A decision's words in the page's own roles: the title a step's
     claim takes, and the lede. */
  .words h3 { color: var(--color-ink); }
  .words p { margin-top: 0.75rem; }
</style>
