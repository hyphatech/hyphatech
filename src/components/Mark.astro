---
/* Hypha's mark, shaded, in white: it stands on night only, in the
   masthead and the footer. On paper it would be brand/hypha-black-shaded.svg. */
interface Props {
  class?: string;
}
const { class: className = "h-6" } = Astro.props;
---

<img src="/brand/hypha-white-shaded.svg" alt="" width="186" height="293" class:list={["w-auto", className]} />
