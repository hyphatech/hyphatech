---
/* The boundary as a pick-and-place: a gantry that takes its own order
   and its own routes, and a fixture that seats every part in one place
   only and refuses the part it has no place for. The SVG is drawn here
   at build time with that part resting proud on the fixture; the
   script runs the gantry while the figure is on
   screen. With reduced motion, or without JavaScript, it rests. */

import "./iso/iso.css";
import { pickSvg } from "./pick-geometry";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const svg = pickSvg();
---

<div class:list={["iso pick", className]} data-pick set:html={svg} />

<script>
  import { translateAlong } from "./iso/iso-kit";
  import { inBin, moves, partsSvg } from "./pick-geometry";
  import { P, REST, sceneAt, shiverAt } from "./pick-model";

  const still = matchMedia("(prefers-reduced-motion: reduce)");

  for (const root of document.querySelectorAll<HTMLElement>("[data-pick]")) {
    const one = (selector: string) => root.querySelector<SVGGElement>(selector)!;
    const all = (selector: string) => [...root.querySelectorAll<SVGGElement>(selector)];
    const groups = { bridge: all('[data-move="bridge"]'), carriage: one('[data-move="carriage"]'), quill: one('[data-move="quill"]') };
    const layers = { scrap: one('[data-layer="scrap"]'), chute: one('[data-layer="chute"]'), rest: one('[data-layer="rest"]'), carried: one('[data-layer="carried"]') };
    const box = one("[data-box]");
    const cover = one("[data-bin-cover]");
    /* Most frames move the head and leave most parts where they lie: a
       layer is rebuilt, and a transform set, only when it changes. */
    const written = new Map<Element, string>();
    const write = (element: Element, value: string, apply: () => void) => {
      if (written.get(element) === value) return;
      written.set(element, value);
      apply();
    };
    const html = (element: Element, value: string) => write(element, value, () => (element.innerHTML = value));
    const transform = (element: Element, value: string) => write(element, value, () => element.setAttribute("transform", value));
    const draw = (time: number) => {
      const scene = sceneAt(time);
      const move = moves(scene.head);
      for (const group of groups.bridge) transform(group, move.bridge);
      transform(groups.carriage, move.carriage);
      transform(groups.quill, move.quill);
      const parts = partsSvg(scene);
      html(layers.scrap, parts.scrap);
      html(layers.chute, parts.chute);
      html(layers.rest, parts.rest);
      html(layers.carried, parts.carried);
      const shown = inBin(scene.head) ? "" : "none";
      write(cover, shown, () => (cover.style.display = shown));
      const [dx, dy] = shiverAt(time);
      transform(box, translateAlong(P, [dx, dy, 0]));
    };

    let clock = REST;
    let last = 0;
    let frame = 0;
    let visible = false;
    const tick = (now: number) => {
      clock += last ? Math.min(now - last, 50) / 1000 : 0;
      last = now;
      draw(clock);
      frame = visible && !still.matches ? requestAnimationFrame(tick) : 0;
    };
    const run = () => {
      if (frame || !visible || still.matches) return;
      last = 0;
      frame = requestAnimationFrame(tick);
    };
    new IntersectionObserver((entries) => {
      visible = entries[entries.length - 1]!.isIntersecting;
      root.toggleAttribute("data-away", !visible);
      run();
    }).observe(root);
    still.addEventListener("change", () => {
      if (still.matches) draw((clock = REST));
      run();
    });
  }
</script>

<style is:global>
  /* The kit's tones in the site's night: warm greys a few steps off the
     ground, graphite for the machine, paper for the parts, gold for the
     nests. Each grey is graphite mixed into night, or paper into
     graphite, so it keeps graphite's warmth and moves with the palette.
     Only the halo, a shadow, is plain black. */
  .iso.pick {
    --pick-tone: var(--graphite-on-night);
    --anatomy-paper: var(--night);
    --anatomy-face: color-mix(in oklab, var(--pick-tone) 15%, var(--night));
    --anatomy-top: color-mix(in oklab, var(--pick-tone) 12%, var(--night));
    --anatomy-shade-0: color-mix(in oklab, var(--pick-tone) 1%, var(--night));
    --anatomy-shade-1: color-mix(in oklab, var(--pick-tone) 4%, var(--night));
    --anatomy-shade-2: color-mix(in oklab, var(--pick-tone) 7%, var(--night));
    --anatomy-shade-3: color-mix(in oklab, var(--pick-tone) 10%, var(--night));
    --anatomy-lit-top: color-mix(in oklab, var(--pick-tone) 22%, var(--night));
    --anatomy-lit-shade: var(--anatomy-face);
    --anatomy-hi: color-mix(in oklab, var(--paper) 72%, var(--pick-tone));
    --anatomy-mid: color-mix(in oklab, var(--pick-tone) 93%, var(--night));
    --anatomy-lo: color-mix(in oklab, var(--pick-tone) 53%, var(--night));
    --anatomy-faint: color-mix(in oklab, var(--pick-tone) 30%, var(--night));
    --anatomy-lit: var(--paper);
    --anatomy-halo: #000;
    --anatomy-halo-opacity: 0.7;
    --anatomy-dot: var(--anatomy-hi);
    --anatomy-weight: 0.75px;
  }
  .iso.pick .iso-line[data-tone="gold"] {
    stroke: var(--color-accent);
  }
  /* The box's light breathes; it says the box is at work, not how. */
  .iso.pick .pick-light circle {
    animation: pick-light 2.4s ease-in-out infinite;
  }
  /* Off screen it holds, so the page has nothing to redraw. */
  .iso.pick[data-away] .pick-light circle {
    animation-play-state: paused;
  }
  @keyframes pick-light {
    50% {
      opacity: 0.25;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .iso.pick .pick-light circle {
      animation: none;
    }
  }
</style>
